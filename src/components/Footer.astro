---
import footer from '../data/footer.json';
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';

const year=new Date().getFullYear();
type FooterIcon='arrow'|'bed'|'bath'|'guests'|'phone'|'mail'|'pin'|'external'|'menu'|'beach'|'walk'|'guernsey'|'history'|'islands'|'food'|'kitchen'|'living'|'garden'|'wifi';
type FooterItem={label:string;url?:string;icon?:string;external?:boolean};
type FooterColumn={title:string;items?:FooterItem[]};
type FooterData={
  intro?:{enabled?:boolean;label?:string;heading?:string;text?:string};
  logo?:{enabled?:boolean;image?:string;alt?:string};
  columns?:FooterColumn[];
  bottom?:{copyrightName?:string;note?:string};
};
const footerData=footer as FooterData;
const allowedIcons=new Set<FooterIcon>(['arrow','bed','bath','guests','phone','mail','pin','external','menu','beach','walk','guernsey','history','islands','food','kitchen','living','garden','wifi']);
const columns=footerData.columns??[];
---
<footer class="site-footer">
  <div class:list={['wrap','footer-grid',!footerData.intro?.enabled&&'without-intro']}>
    {footerData.intro?.enabled&&<div class="footer-intro">
      {footerData.intro.label&&<p class="eyebrow eyebrow-light">{footerData.intro.label}</p>}
      {footerData.intro.heading&&<h2>{footerData.intro.heading}</h2>}
      {footerData.intro.text&&<p>{footerData.intro.text}</p>}
    </div>}

    {footerData.logo?.enabled&&footerData.logo.image&&<a class="footer-brand" href="/" aria-label="Les Buttes Holiday Cottages — home">
      <ResponsiveImage src={footerData.logo.image} alt={footerData.logo.alt??''} widths={[220,360,480]} sizes="17rem" />
    </a>}

    <div class="footer-columns">
      {columns.map(column=><div class="footer-column">
        {column.title&&<h3>{column.title}</h3>}
        {(column.items??[]).map(item=>{
          const icon=allowedIcons.has(item.icon as FooterIcon)?item.icon as FooterIcon:undefined;
          const url=item.url?.trim();
          return url
            ? <a class:list={['footer-item',icon&&'footer-link']} href={url} target={item.external?'_blank':undefined} rel={item.external?'noopener':undefined}>
                {icon&&<Icon name={icon} size={18}/>}<span>{item.label}</span>
              </a>
            : <span class:list={['footer-item','footer-text',icon&&'footer-link']}>
                {icon&&<Icon name={icon} size={18}/>}<span>{item.label}</span>
              </span>;
        })}
      </div>)}
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {year} {footerData.bottom?.copyrightName}</p>
    {footerData.bottom?.note&&<p>{footerData.bottom.note}</p>}
  </div>
</footer>

<style>
.site-footer{margin-top:clamp(4rem,10vw,8rem);padding-top:clamp(3.5rem,7vw,5rem);color:#fff;background:var(--deep)}
body .site-footer .footer-grid{display:grid;grid-template-areas:"intro" "brand" "columns";grid-template-columns:minmax(0,1fr);gap:2.25rem;padding-bottom:clamp(2.5rem,5vw,4rem)}
.footer-intro{grid-area:intro;max-width:29rem}
.footer-intro h2{max-width:14ch;margin-bottom:2rem;font-size:clamp(2.6rem,5vw,4.1rem)}
.footer-intro>p:last-child{max-width:27rem;margin:0;color:#ffffffc4}
.footer-brand{grid-area:brand;display:block!important;width:min(100%,17rem)!important;margin:0!important;padding:.4rem .55rem;background:#f7f3e9;border-radius:.55rem;line-height:0;align-self:start}
.footer-brand picture,.footer-brand img{display:block;width:100%;height:auto}
.footer-columns{grid-area:columns;display:grid;grid-template-columns:minmax(0,1fr);gap:1.8rem 2.25rem;min-width:0}
.footer-column{min-width:0}
.footer-column h3{margin:0 0 .8rem;font:700 .82rem var(--body);letter-spacing:.08em;text-transform:uppercase}
.footer-item{display:block;margin:.65rem 0;color:#ffffffe2;text-decoration:none;line-height:1.65}
a.footer-item:hover{text-decoration:underline;text-underline-offset:.2em}
.footer-link{display:flex!important;align-items:flex-start;gap:.55rem}
.footer-link svg{flex:0 0 auto;margin-top:.2rem}
.footer-text>span,.footer-item>span{white-space:pre-line}
.site-footer .footer-bottom{display:flex;flex-direction:column;gap:.45rem;margin-top:0;padding-block:1.35rem;color:#ffffff8c;border-top:1px solid #ffffff24;font-size:.78rem}
.site-footer .footer-bottom p{margin:0}

/* Internal pages intentionally use the compact footer introduced during the redline pass. */
body:not(.page-home) .site-footer .footer-grid{grid-template-areas:"brand" "columns"!important;grid-template-columns:minmax(0,1fr)!important;gap:1.5rem!important;padding-bottom:2rem!important}
body:not(.page-home) .site-footer .footer-brand{justify-self:start!important;width:13rem!important}
body:not(.page-home) .site-footer .footer-columns{grid-template-columns:minmax(0,1fr);gap:1.25rem 2rem}
body:not(.page-home) .site-footer .footer-column h3{margin-bottom:.45rem!important}
body:not(.page-home) .site-footer .footer-item{margin:.4rem 0!important}
body:not(.page-home) .site-footer .footer-bottom{padding-block:1rem!important}

@media(min-width:40rem) and (max-width:63.99rem){
  body .site-footer .footer-grid{grid-template-areas:"intro intro" "brand brand" "columns columns";grid-template-columns:1fr 1fr}
  .footer-columns{grid-template-columns:repeat(2,minmax(0,1fr))}
  body:not(.page-home) .site-footer .footer-grid{grid-template-areas:"brand brand" "columns columns"!important;grid-template-columns:1fr 1fr!important}
  body:not(.page-home) .site-footer .footer-columns{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(min-width:64rem){
  body .site-footer .footer-grid{grid-template-areas:"intro brand" "intro columns";grid-template-columns:minmax(22rem,1.1fr) minmax(0,1.9fr);grid-template-rows:auto 1fr;column-gap:clamp(3rem,6vw,7rem);row-gap:1.25rem;align-items:start}
  body .site-footer .footer-grid.without-intro{grid-template-areas:"brand" "columns";grid-template-columns:minmax(0,1fr)}
  .footer-brand{justify-self:end}
  .footer-intro{align-self:start}
  .footer-columns{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem 2rem}
  .site-footer .footer-bottom{flex-direction:row;justify-content:space-between;align-items:center}
  body:not(.page-home) .site-footer .footer-grid{grid-template-areas:"brand columns"!important;grid-template-columns:minmax(11rem,.42fr) minmax(0,1.58fr)!important;column-gap:clamp(2.5rem,5vw,5rem)!important;align-items:start}
  body:not(.page-home) .site-footer .footer-columns{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem 2rem}
}
@media(min-width:72rem){
  .footer-columns{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem 1.35rem}
  body:not(.page-home) .site-footer .footer-columns{grid-template-columns:repeat(4,minmax(0,1fr));gap:1.5rem 1.35rem}
}
</style>

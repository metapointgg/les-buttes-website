---
import site from '../data/site.json'; import Icon from './Icon.astro'; const year=new Date().getFullYear();
---
<footer class="site-footer"><div class="wrap footer-grid"><div class="footer-intro"><p class="eyebrow eyebrow-light">A warm Guernsey welcome</p><h2>Slow down. Settle in. Make yourself at home.</h2><p>Family-run self-catering cottages in peaceful St Pierre du Bois.</p></div><div><h3>Visit</h3><address>{site.address.street}<br/>{site.address.locality}<br/>{site.address.island} {site.address.postcode}</address><a class="footer-link" href="/find-us/"><Icon name="pin" size={18}/>Directions</a></div><div><h3>Contact</h3><a class="footer-link" href={`tel:${site.telephoneHref}`}><Icon name="phone" size={18}/>{site.telephoneDisplay}</a><a class="footer-link" href={`mailto:${site.email}`}><Icon name="mail" size={18}/>{site.email}</a></div><div><h3>Explore</h3><a href="/cottages/">Our cottages</a><a href="/explore-guernsey/">Things to do</a><a href="/about/">Our story</a><a href="/privacy/">Privacy</a></div></div><div class="wrap footer-bottom"><p>© {year} {site.name}</p><p>Bookings are made securely through Airbnb.</p></div></footer>

---
import site from '../data/site.json';
import Icon from './Icon.astro';
import logoHeader from '../assets/images/logo-header.png';
const year=new Date().getFullYear();
---
<footer class="site-footer"><div class="wrap footer-grid"><div class="footer-intro"><a class="footer-brand" href="/" aria-label="Les Buttes Holiday Cottages — home"><img src={logoHeader.src} width={logoHeader.width} height={logoHeader.height} alt="" loading="lazy" /></a><p class="eyebrow eyebrow-light">A warm Guernsey welcome</p><h2>Slow down. Settle in. Make yourself at home.</h2><p>Family-run self-catering cottages in peaceful St Pierre du Bois.</p></div><div><h3>Visit</h3><address>{site.address.street}<br/>{site.address.locality}<br/>{site.address.island} {site.address.postcode}</address><a class="footer-link" href="/find-us/"><Icon name="pin" size={18}/>Directions</a></div><div><h3>Contact</h3><a class="footer-link" href={`tel:${site.telephoneHref}`}><Icon name="phone" size={18}/>{site.telephoneDisplay}</a><a class="footer-link" href={`mailto:${site.email}`}><Icon name="mail" size={18}/>{site.email}</a></div><div><h3>Explore</h3><a href="/cottages/">Our cottages</a><a href="/gardens/">Gardens</a><a href="/explore-guernsey/">Things to do</a><a href="/about/">Our story</a><a href="/privacy/">Privacy</a></div></div><div class="wrap footer-bottom"><p>© {year} {site.name}</p><p>Bookings are made securely through Airbnb.</p></div></footer>
<style>
.footer-brand{display:block!important;width:min(100%,17rem)!important;margin:0 0 1.5rem!important;padding:.35rem .45rem;background:#f7f3e9;border-radius:.55rem;line-height:0}
.footer-brand img{display:block;width:100%;height:auto}
</style>

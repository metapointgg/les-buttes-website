---
import ResponsiveImage from './ResponsiveImage.astro';
interface Props{items:{image:string;alt:string;caption:string}[]}
const{items}=Astro.props;
---
<div class="gallery cottage-gallery" data-cottage-gallery>
  {items.map((item,i)=>{
    const dialogId=`cottage-gallery-${i}`;
    return <figure class:list={[i===0&&'wide']} data-gallery-index={i}>
      <button class="cottage-gallery-trigger" type="button" data-cottage-gallery-open={dialogId} aria-label={`Open ${item.caption}`}>
        <ResponsiveImage src={item.image} alt={item.alt} widths={[420,720,1100]} sizes={i===0?'(max-width:760px) 100vw,66vw':'(max-width:760px) 100vw,33vw'}/>
      </button>
      <figcaption>{item.caption}</figcaption>
      <dialog id={dialogId} class="cottage-gallery-lightbox" data-cottage-gallery-dialog data-gallery-index={i}>
        <button class="cottage-gallery-close" type="button" data-cottage-gallery-close aria-label="Close image">×</button>
        {items.length>1&&<button class="cottage-gallery-nav cottage-gallery-prev" type="button" data-cottage-gallery-prev aria-label="Previous image">‹</button>}
        <ResponsiveImage src={item.image} alt={item.alt} widths={[960,1280,1600]} sizes="92vw"/>
        {items.length>1&&<button class="cottage-gallery-nav cottage-gallery-next" type="button" data-cottage-gallery-next aria-label="Next image">›</button>}
        <p>{item.caption}</p>
      </dialog>
    </figure>
  })}
</div>

<script is:inline>
(() => {
  if (window.__lesButtesCottageGalleryInit) return;
  window.__lesButtesCottageGalleryInit = true;

  const dialogs = () => Array.from(document.querySelectorAll('[data-cottage-gallery-dialog]'));
  const openAt = (index) => {
    const all = dialogs();
    if (!all.length) return;
    const nextIndex = (index + all.length) % all.length;
    const current = all.find(dialog => dialog.open);
    if (current instanceof HTMLDialogElement) current.close();
    const next = all[nextIndex];
    if (next instanceof HTMLDialogElement) next.showModal();
  };
  const activeIndex = () => {
    const all = dialogs();
    return all.findIndex(dialog => dialog.open);
  };

  document.addEventListener('click', function(event) {
    const target = event.target instanceof Element ? event.target : null;
    const openButton = target?.closest('[data-cottage-gallery-open]');
    if (openButton) {
      const id = openButton.getAttribute('data-cottage-gallery-open');
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }
    if (target?.closest('[data-cottage-gallery-prev]')) { openAt(activeIndex()-1); return; }
    if (target?.closest('[data-cottage-gallery-next]')) { openAt(activeIndex()+1); return; }
    const closeButton = target?.closest('[data-cottage-gallery-close]');
    if (closeButton) {
      const dialog = closeButton.closest('dialog');
      if (dialog instanceof HTMLDialogElement) dialog.close();
      return;
    }
    if (target instanceof HTMLDialogElement) target.close();
  });

  document.addEventListener('keydown', event => {
    const index = activeIndex();
    if (index < 0) return;
    if (event.key === 'ArrowLeft') { event.preventDefault(); openAt(index-1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); openAt(index+1); }
  });

  let touchStartX = null;
  document.addEventListener('touchstart', event => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-cottage-gallery-dialog]')) return;
    touchStartX = event.changedTouches[0]?.clientX ?? null;
  }, {passive:true});
  document.addEventListener('touchend', event => {
    if (touchStartX === null || !(event.target instanceof Element) || !event.target.closest('[data-cottage-gallery-dialog]')) return;
    const endX = event.changedTouches[0]?.clientX ?? touchStartX;
    const delta = endX - touchStartX;
    touchStartX = null;
    if (Math.abs(delta) < 50) return;
    const index = activeIndex();
    if (index >= 0) openAt(index + (delta < 0 ? 1 : -1));
  }, {passive:true});
})();
</script>

<style>
.cottage-gallery{gap:.8rem}
.cottage-gallery figure{border-radius:.3rem}
.cottage-gallery-trigger{display:block;width:100%;height:100%;padding:0;border:0;background:transparent;cursor:zoom-in}
.cottage-gallery-trigger picture,.cottage-gallery-trigger img{width:100%;height:100%;object-fit:cover}
.cottage-gallery-trigger:focus-visible,.cottage-gallery-lightbox button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.cottage-gallery-lightbox{width:min(94vw,88rem);max-height:92vh;padding:0;border:0;background:#0c1713;box-shadow:0 30px 90px #0008}
.cottage-gallery-lightbox::backdrop{background:#07110de8}
.cottage-gallery-lightbox picture,.cottage-gallery-lightbox img{display:block;width:100%;max-height:82vh;object-fit:contain}
.cottage-gallery-lightbox p{margin:0;padding:.8rem 4rem;color:#fff;text-align:center}
.cottage-gallery-close,.cottage-gallery-nav{position:absolute;z-index:3;display:grid;place-items:center;color:#fff;background:#0b231dcc;border:1px solid #ffffff66;border-radius:50%;cursor:pointer}
.cottage-gallery-close{top:.65rem;right:.65rem;width:2.5rem;height:2.5rem;font-size:1.5rem}
.cottage-gallery-nav{top:50%;width:2.8rem;height:2.8rem;transform:translateY(-50%);font-size:2rem;line-height:1}
.cottage-gallery-prev{left:.75rem}.cottage-gallery-next{right:.75rem}
@media(max-width:36rem){.cottage-gallery-nav{top:auto;bottom:.65rem;transform:none}.cottage-gallery-lightbox p{padding-inline:3.8rem}}
</style>

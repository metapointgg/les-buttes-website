---
import charityData from '../data/charities.json';

const legacy=charityData.legacy;
---
{legacy && (
  <section class="charity-legacy-section">
    <div class="wrap wide">
      <div class="charity-legacy-top">
        <div class="charity-legacy-copy">
          {legacy.eyebrow && <p class="eyebrow charity-legacy-eyebrow">{legacy.eyebrow}</p>}
          <h2>{legacy.title}</h2>
          <p class="charity-legacy-intro">{legacy.intro}</p>
        </div>

        <aside class="charity-legacy-quote" aria-label="The Les Buttes family">
          <span class="charity-legacy-quote-mark" aria-hidden="true">“</span>
          <blockquote>{legacy.quote}</blockquote>
          {legacy.quoteAttribution && <p>{legacy.quoteAttribution}</p>}
        </aside>
      </div>
    </div>
  </section>
)}

<style>
.charity-legacy-section{padding:clamp(3.5rem,7vw,6.5rem) 0;background:var(--paper)}
.charity-legacy-top{display:grid;gap:clamp(2rem,5vw,4.5rem);align-items:start}
.charity-legacy-copy{max-width:47rem}
.charity-legacy-eyebrow{display:flex;align-items:center;gap:1rem;margin:0 0 1.3rem;color:var(--green);font-size:.74rem;font-weight:750;letter-spacing:.18em;text-transform:uppercase}
.charity-legacy-eyebrow::before{content:"";width:3.2rem;height:1px;background:var(--green);opacity:.7}
.charity-legacy-copy h2{max-width:46rem;margin:0;font-size:clamp(2.8rem,5vw,4.6rem);line-height:.99;letter-spacing:-.035em}
.charity-legacy-intro{max-width:42rem;margin:1.5rem 0 0;color:var(--soft);font-size:clamp(1rem,1.5vw,1.16rem);line-height:1.65}
.charity-legacy-quote{position:relative;margin:0;padding:clamp(2rem,4vw,3rem);background:linear-gradient(135deg,#f3f2e8,#f7f6ef);border-radius:.7rem}
.charity-legacy-quote-mark{display:block;height:2.2rem;color:#aab68b;font:700 4.5rem/.8 var(--display)}
.charity-legacy-quote blockquote{margin:.35rem 0 1.5rem;color:var(--ink);font:italic 500 clamp(1.25rem,2vw,1.75rem)/1.42 var(--display)}
.charity-legacy-quote>p{display:flex;align-items:center;gap:.8rem;margin:0;color:var(--green);font-size:.72rem;font-weight:750;letter-spacing:.2em;text-transform:uppercase}
.charity-legacy-quote>p::before{content:"";width:2.7rem;height:1px;background:var(--line)}
@media(min-width:64rem){
  .charity-legacy-top{grid-template-columns:minmax(0,1.18fr) minmax(20rem,.82fr)}
}
@media(max-width:35rem){
  .charity-legacy-section{padding-top:3rem;padding-bottom:3.5rem}
  .charity-legacy-copy h2{font-size:clamp(2.35rem,12vw,3.2rem)}
}
</style>

---
import type{CollectionEntry}from'astro:content'; import ResponsiveImage from './ResponsiveImage.astro'; import CottageStats from './CottageStats.astro'; import Icon from './Icon.astro'; interface Props{cottage:CollectionEntry<'cottages'>} const{cottage}=Astro.props; const c=cottage.data;
---
<article class="cottage-card"><a class="card-image" href={`/cottages/${c.slug}/`} tabindex="-1"><ResponsiveImage src={c.heroImage} alt="" widths={[480,720,960]} sizes="(max-width:760px) 100vw,50vw"/></a><div class="card-body"><p class="eyebrow">{c.eyebrow}</p><h2><a href={`/cottages/${c.slug}/`}>{c.name}</a></h2><p>{c.summary}</p><CottageStats sleeps={c.sleeps} bedrooms={c.bedrooms} beds={c.beds} bathrooms={c.bathrooms} dogFriendly={c.dogFriendly} compact/><div class="card-actions"><a class="text-link" href={`/cottages/${c.slug}/`}>Discover {c.name.replace(' Cottage','')}<Icon name="arrow" size={18}/></a>{c.airbnbUrl&&<a class="text-link muted" href={c.airbnbUrl} target="_blank" rel="noopener">View on Airbnb<Icon name="external" size={16}/></a>}</div></div></article>

---
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import CottageStats from './CottageStats.astro';
import Icon from './Icon.astro';

interface Props { cottage: CollectionEntry<'cottages'> }
const { cottage } = Astro.props;
const c = cottage.data;
---
<article class="cottage-card">
  <a class="card-image" href={`/cottages/${c.slug}/`} tabindex="-1">
    <ResponsiveImage src={c.heroImage} alt="" widths={[480,720,960]} sizes="(max-width:760px) 100vw,50vw"/>
  </a>
  <div class="card-body">
    <h2><a href={`/cottages/${c.slug}/`}>{c.name}</a></h2>
    <p class="cottage-card-summary">{c.summary}</p>
    <CottageStats sleeps={c.sleeps} bedrooms={c.bedrooms} beds={c.beds} bathrooms={c.bathrooms} dogFriendly={c.dogFriendly} compact/>
    <div class="card-actions">
      <a class="button button-secondary cottage-card-button" href={`/cottages/${c.slug}/`}>View cottage<Icon name="arrow" size={18}/></a>
    </div>
  </div>
</article>

---
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import CottageStats from './CottageStats.astro';
import Icon from './Icon.astro';

interface Props {
  cottage: CollectionEntry<'cottages'>;
  showPreviewStrip?: boolean;
}
const { cottage, showPreviewStrip = false } = Astro.props;
const c = cottage.data;
const previewImages = c.gallery.filter(item => item.image !== c.heroImage).slice(0,3);
const outdoorSpace = c.facilities.find(item => /garden|outdoor/i.test(item));
const comparisonCues = c.slug === 'geranium'
  ? [
      { label: 'Best suited to', text: 'couples and smaller families' },
      { text: outdoorSpace ?? 'Private enclosed garden' },
      { text: 'Cosy and characterful' }
    ]
  : c.slug === 'honeysuckle'
    ? [
        { label: 'Best suited to', text: 'families and groups' },
        { text: outdoorSpace ?? 'Private garden' },
        { text: 'Spacious and flexible' }
      ]
    : [{ text: c.summary }];
---
<article class:list={["cottage-card",showPreviewStrip && "cottage-card-comparison"]}>
  <a class="card-image" href={`/cottages/${c.slug}/`} tabindex="-1">
    <ResponsiveImage src={c.heroImage} alt="" widths={[480,720,960]} sizes="(max-width:760px) 100vw,50vw"/>
  </a>
  <div class="card-body">
    <h2><a href={`/cottages/${c.slug}/`}>{c.name}</a></h2>
    {showPreviewStrip && <p class="cottage-card-tagline">{c.tagline}</p>}
    {!showPreviewStrip && <p class="cottage-card-summary">{c.tagline}</p>}
    <CottageStats sleeps={c.sleeps} bedrooms={c.bedrooms} beds={c.beds} bathrooms={c.bathrooms} dogFriendly={showPreviewStrip ? false : c.dogFriendly} compact={true}/>
    {showPreviewStrip && c.dogFriendly && <p class="cottage-dog-friendly">● Dog friendly</p>}
    {showPreviewStrip && (
      <ul class="cottage-decision-cues" aria-label={`${c.name} at a glance`}>
        {comparisonCues.map(cue => (
          <li>{cue.label && <strong>{cue.label}</strong>} {cue.text}</li>
        ))}
      </ul>
    )}
    <div class="card-actions">
      <a class="button button-secondary cottage-card-button" href={`/cottages/${c.slug}/`}>{showPreviewStrip ? `View ${c.name}` : 'View cottage'}<Icon name="arrow" size={18}/></a>
    </div>
  </div>
  {showPreviewStrip && previewImages.length > 0 && (
    <div class="cottage-preview-strip" aria-hidden="true">
      {previewImages.map(item => <ResponsiveImage src={item.image} alt="" widths={[220,320,420]} sizes="(max-width:760px) 33vw, 15vw" />)}
    </div>
  )}
</article>

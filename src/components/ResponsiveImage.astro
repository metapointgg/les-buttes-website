---
import { Picture } from 'astro:assets'; import { getImage } from '../lib/images';
interface Props { src:string; alt:string; class?:string; widths?:number[]; sizes?:string; loading?:'lazy'|'eager'; fetchpriority?:'high'|'low'|'auto' }
const {src,alt,class:className,widths=[480,768,1100,1440],sizes='(max-width: 768px) 100vw, 50vw',loading='lazy',fetchpriority='auto'}=Astro.props;
---
<Picture src={getImage(src)} alt={alt} class={className} widths={widths} sizes={sizes} formats={['avif','webp']} loading={loading} fetchpriority={fetchpriority} quality={76}/>

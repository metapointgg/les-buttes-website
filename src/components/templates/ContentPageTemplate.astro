---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../PageIntro.astro';
import PageSections from '../PageSections.astro';

interface Props { pageData:any }
const {pageData:p}=Astro.props;
const hasHero=Boolean(p.heroImage||p.heroVideo);
---
<BaseLayout title={p.seo.title} description={p.seo.description}>
  {hasHero ? (
    <PageIntro
      eyebrow={p.eyebrow}
      title={p.title}
      intro={p.intro}
      mediaType={p.heroMediaType}
      imageSrc={p.heroImage}
      imageAlt={p.heroAlt}
      pan={p.heroPan}
      videoSrc={p.heroVideo}
      posterSrc={p.heroPoster}
    >
      {(p.heroPrimaryLabel && p.heroPrimaryUrl) || (p.heroSecondaryLabel && p.heroSecondaryUrl) ? (
        <div class="hero-actions page-intro-actions">
          {p.heroPrimaryLabel && p.heroPrimaryUrl && <a class="button button-light" href={p.heroPrimaryUrl}>{p.heroPrimaryLabel}</a>}
          {p.heroSecondaryLabel && p.heroSecondaryUrl && <a class="button button-outline" href={p.heroSecondaryUrl}>{p.heroSecondaryLabel}</a>}
        </div>
      ) : null}
    </PageIntro>
  ) : (
    <div class="wrap"><PageIntro eyebrow={p.eyebrow} title={p.title} intro={p.intro}/></div>
  )}
  <PageSections sections={p.sections}/>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import CottageCard from './CottageCard.astro';
import Callout from './Callout.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';

interface Props { sections?: any[] }
const { sections = [] } = Astro.props;
const visibleSections = sections.filter(section => section.enabled !== false);
const cottages=(await getCollection('cottages')).filter(c=>c.data.available).sort((a,b)=>a.data.name.localeCompare(b.data.name));
const directionsUrl=`https://www.google.com/maps/dir/?api=1&destination=${site.coordinates.latitude},${site.coordinates.longitude}`;
const mapUrl=`https://www.google.com/maps?q=${site.coordinates.latitude},${site.coordinates.longitude}&z=15&output=embed`;
const tokens:Record<string,string>={
  email:site.email,
  telephoneHref:site.telephoneHref,
  telephoneDisplay:site.telephoneDisplay,
  street:site.address.street,
  locality:site.address.locality,
  island:site.address.island,
  postcode:site.address.postcode,
  directionsUrl
};
const resolve=(value?:string)=>value?.replace(/\{\{(\w+)\}\}/g,(_,key)=>tokens[key]??`{{${key}}}`)??'';
const paragraphs = (text?: string) => resolve(text).split(/\n\s*\n/).filter(Boolean);
const sectionTheme = (section:any,index:number) => {
  if(section.theme === 'green') return 'green';
  if(section.theme === 'cream') return '';
  if(section.theme === 'paper') return 'paper';
  return index % 2 === 0 ? 'paper' : '';
};
const widthClass = (section:any) => section.width === 'narrow' ? 'section-builder-narrow' : section.width === 'wide' ? 'section-builder-wide' : '';
const externalAttrs = (external?:boolean) => external ? {target:'_blank',rel:'noopener'} : {};
---
{visibleSections.map((section,index) => {
  const theme = sectionTheme(section,index);
  const width = widthClass(section);
  const eyebrowClass = theme === 'green' ? 'eyebrow eyebrow-light' : 'eyebrow';

  if(section.type === 'cta') return (
    <Callout
      title={resolve(section.title)}
      text={resolve(section.text)}
      href={resolve(section.buttonUrl) || '/contact/'}
      label={resolve(section.buttonLabel) || 'Find out more'}
      secondaryHref={resolve(section.secondaryButtonUrl) || undefined}
      secondaryLabel={resolve(section.secondaryButtonLabel) || undefined}
    />
  );

  if(section.type === 'splitQuote') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-split-quote',width]}>
        <div>
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          <div class:list={['intro-copy',theme === 'green' && 'on-green-copy']}>{paragraphs(section.text).map(text=><p>{text}</p>)}</div>
        </div>
        <aside class:list={['section-builder-quote-card',theme === 'green' && 'on-green-card']}>
          <blockquote>“{resolve(section.quote)}”</blockquote>
          {section.attribution && <p>{resolve(section.attribution)}</p>}
        </aside>
      </div>
    </section>
  );

  if(section.type === 'cottageListing') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text=><p class="lede">{text}</p>)}
        </header>
        <div class="cottage-grid">{cottages.map(c=><CottageCard cottage={c}/>)}</div>
      </div>
    </section>
  );

  if(section.type === 'notice') return (
    <section class:list={['section-tight',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        <div class="notice">{section.title && <strong>{resolve(section.title)} </strong>}{resolve(section.text)}</div>
      </div>
    </section>
  );

  if(section.type === 'locationMap') return (
    <section class:list={['section',theme]} id="map">
      <div class:list={['wrap',width]}>
        {(section.eyebrow || section.title || section.text) && <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          {section.title && <h2>{resolve(section.title)}</h2>}
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>}
        <div class="map-card">
          <iframe src={mapUrl} title="Map showing Les Buttes Holiday Cottages" loading="lazy"></iframe>
          <div class="map-card-content"><strong>Les Buttes Holiday Cottages</strong><p>{site.address.street}, {site.address.locality}, {site.address.island} {site.address.postcode}</p><a class="button" href={directionsUrl} target="_blank" rel="noopener">Start directions<Icon name="external" size={17}/></a></div>
        </div>
      </div>
    </section>
  );

  if(section.type === 'steps') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.items?.length > 0 && <ol class="directions">{section.items.map((item:any)=><li><strong>{resolve(item.title)}</strong>{item.text&&<> {resolve(item.text)}</>}</li>)}</ol>}
      </div>
    </section>
  );

  if(section.type === 'feature') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-feature',width,section.imagePosition === 'right' && 'image-right']}>
        {section.image && <div class="section-builder-feature-image"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[480,768,1100]} sizes="(max-width: 768px) 100vw, 50vw"/></div>}
        <div class="section-builder-copy">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p>{text}</p>)}
          {section.buttonLabel && section.buttonUrl && <a class:list={['button',theme === 'green' && 'button-light']} href={resolve(section.buttonUrl)} {...externalAttrs(section.buttonExternal)}>{resolve(section.buttonLabel)}<Icon name={section.buttonExternal?'external':'arrow'} size={18}/></a>}
        </div>
      </div>
    </section>
  );

  if(section.type === 'image') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-image-wrap',width]}>
        {(section.eyebrow || section.title || section.text) && <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          {section.title && <h2>{resolve(section.title)}</h2>}
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>}
        {section.image && <figure class="section-builder-image"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[640,960,1280,1600]} sizes="100vw"/>{section.imageCaption && <figcaption>{resolve(section.imageCaption)}</figcaption>}</figure>}
      </div>
    </section>
  );

  if(section.type === 'cards' || section.type === 'iconCards') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.items?.length > 0 && <div class="section-builder-card-grid">{section.items.map((item:any) => <article class:list={['section-builder-card',theme === 'green' && 'on-green',item.image && 'has-image']}>
          {item.image && <div class="section-builder-card-image"><ResponsiveImage src={item.image} alt={resolve(item.imageAlt)} widths={[360,560,760]} sizes="(max-width: 768px) 100vw, 33vw"/></div>}
          <div class="section-builder-card-content">
            {item.kicker && <span class="section-builder-kicker">{resolve(item.kicker)}</span>}
            {section.type === 'iconCards' && item.icon && !item.linkLabel && <span class="section-builder-icon"><Icon name={item.icon} size={26}/></span>}
            <h3>{resolve(item.title)}</h3>
            {item.text && <p>{resolve(item.text)}</p>}
            {item.linkLabel && item.linkUrl && (
              section.type === 'iconCards'
                ? <a class="section-builder-pill" href={resolve(item.linkUrl)} {...externalAttrs(item.external)}><span>{resolve(item.linkLabel)}</span><span class="section-builder-pill-icon"><Icon name={item.icon ?? (item.external?'external':'arrow')} size={19}/></span></a>
                : <a class="text-link" href={resolve(item.linkUrl)} {...externalAttrs(item.external)}>{resolve(item.linkLabel)}<Icon name={item.external?'external':'arrow'} size={17}/></a>
            )}
          </div>
        </article>)}</div>}
      </div>
    </section>
  );

  if(section.type === 'list') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <h2>{resolve(section.title)}</h2>
        {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        {section.listItems?.length > 0 && <ul class="section-builder-list">{section.listItems.map((item:string) => <li>{resolve(item)}</li>)}</ul>}
      </div>
    </section>
  );

  if(section.type === 'gallery') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.galleryImages?.length > 0 && <div class="section-builder-gallery">{section.galleryImages.map((item:any) => <figure>
          <ResponsiveImage src={item.image} alt={resolve(item.alt)} widths={[480,768,1100]} sizes="(max-width: 768px) 100vw, 33vw"/>
          {item.caption && <figcaption>{resolve(item.caption)}</figcaption>}
        </figure>)}</div>}
      </div>
    </section>
  );

  if(section.type === 'quote') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-quote',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <blockquote>“{resolve(section.quote ?? section.text)}”</blockquote>
        {section.attribution && <p class="section-builder-attribution">{resolve(section.attribution)}</p>}
      </div>
    </section>
  );

  if(section.type === 'map') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.image && <div class="section-builder-map"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[640,960,1280,1600]} sizes="100vw"/></div>}
      </div>
    </section>
  );

  return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <h2>{resolve(section.title)}</h2>
        <div class="prose">{paragraphs(section.text).map(text => <p>{text}</p>)}</div>
        {section.buttonLabel && section.buttonUrl && <a class:list={['button',theme === 'green' && 'button-light']} href={resolve(section.buttonUrl)} {...externalAttrs(section.buttonExternal)}>{resolve(section.buttonLabel)}<Icon name={section.buttonExternal?'external':'arrow'} size={18}/></a>}
      </div>
    </section>
  );
})}

<style>
.section-builder-narrow{max-width:56rem}.section-builder-wide{max-width:88rem}.section-builder-feature{display:grid;gap:clamp(2rem,6vw,5rem);align-items:center}.section-builder-feature-image{overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius);box-shadow:var(--shadow)}.section-builder-feature-image picture,.section-builder-feature-image img{width:100%;height:100%;object-fit:cover}.section-builder-copy{max-width:42rem}.section-builder-copy>p:not(.eyebrow){color:var(--soft);font-size:1.06rem}.green .section-builder-copy>p:not(.eyebrow),.green .lede{color:#ffffffc7}.section-builder-copy .button{margin-top:.5rem}.section-builder-split-quote{display:grid;gap:2.5rem;align-items:center}.section-builder-split-quote>div>h2{max-width:13ch}.on-green-copy{color:#ffffffc7}.section-builder-quote-card{padding:clamp(2rem,5vw,4rem);color:#fff;background:#285545;border-radius:var(--radius)}.section-builder-quote-card blockquote{margin:0 0 2rem;font:500 clamp(1.9rem,4vw,3.1rem)/1.18 var(--display)}.section-builder-quote-card p{margin:0;color:#ffffffd1;font-size:1.02rem}.section-builder-quote-card.on-green-card{color:var(--ink);background:var(--paper)}.section-builder-quote-card.on-green-card p{color:var(--soft)}.section-builder-image-wrap{display:grid;justify-items:center}.section-builder-image{width:min(100%,64rem);margin:0}.section-builder-image picture,.section-builder-image img{width:100%;height:auto;border-radius:var(--radius)}.section-builder-image figcaption{margin-top:.7rem;color:var(--soft);font-size:.85rem;text-align:center}.section-builder-card-grid{display:grid;gap:1rem}.section-builder-card{display:flex;flex-direction:column;overflow:hidden;padding:0;background:var(--paper);border:1px solid var(--line);border-radius:.85rem}.section-builder-card-content{display:flex;flex:1;flex-direction:column;padding:1.5rem}.section-builder-card-image{overflow:hidden;aspect-ratio:16/10;background:var(--pale)}.section-builder-card-image picture,.section-builder-card-image img{display:block;width:100%;height:100%;object-fit:cover}.section-builder-card.on-green{background:#ffffff12;border-color:#ffffff2b}.section-builder-card h3{font:700 1.05rem var(--body);letter-spacing:0}.section-builder-card p{color:var(--soft);white-space:pre-line}.section-builder-card.on-green p{color:#ffffffc7}.section-builder-card.on-green .text-link{color:#fff}.section-builder-kicker{display:block;margin-bottom:1rem;color:var(--gold);font:1.2rem var(--display)}.section-builder-icon{display:grid;width:3rem;height:3rem;margin-bottom:1.1rem;place-items:center;color:var(--green);background:var(--pale);border-radius:50%}.section-builder-card.on-green .section-builder-icon{color:var(--deep);background:#ffffffe8}.section-builder-pill{display:inline-flex;align-items:center;justify-content:space-between;gap:.8rem;width:max-content;max-width:100%;margin-top:auto;padding:.55rem .55rem .55rem 1rem;color:var(--green);background:var(--cream);border:1px solid #194c3d33;border-radius:999px;font-size:.92rem;font-weight:700;line-height:1.25;text-decoration:none;transition:background .2s,border-color .2s,transform .2s}.section-builder-pill:hover{background:var(--pale);border-color:#194c3d66;transform:translateY(-1px)}.section-builder-pill-icon{display:grid;flex:0 0 2.1rem;width:2.1rem;height:2.1rem;place-items:center;color:#fff;background:var(--green);border-radius:50%}.section-builder-card.on-green .section-builder-pill{color:var(--deep);background:#fff}.section-builder-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.75rem;margin:2rem 0 0;padding:0;list-style:none}.section-builder-list li{padding:1rem 1.15rem;background:var(--paper);border:1px solid var(--line);border-radius:.75rem;font-weight:600}.paper .section-builder-list li{background:var(--cream)}.green .section-builder-list li{background:#ffffff12;border-color:#ffffff2b}.section-builder-gallery{display:grid;gap:.75rem}.section-builder-gallery figure{position:relative;overflow:hidden;min-height:16rem;margin:0;background:var(--pale);border-radius:.8rem}.section-builder-gallery picture,.section-builder-gallery img{width:100%;height:100%;object-fit:cover}.section-builder-gallery figcaption{position:absolute;right:.6rem;bottom:.6rem;left:.6rem;padding:.55rem .7rem;color:#fff;background:linear-gradient(90deg,#000a,#0002);border-radius:.4rem;font-size:.8rem}.section-builder-quote{max-width:58rem;text-align:center}.section-builder-quote blockquote{margin:0;font:500 clamp(2rem,5vw,3.8rem)/1.18 var(--display)}.section-builder-attribution{margin:1.5rem 0 0;color:var(--soft);font-weight:700}.green .section-builder-attribution{color:#ffffffbf}.section-builder-map{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.section-builder-map picture,.section-builder-map img{width:100%;height:auto}.green .text-link{color:#fff}
@media(max-width:27rem){.section-builder-pill{width:100%}}
@media(min-width:48rem){.section-builder-card-grid{grid-template-columns:repeat(2,1fr)}.section-builder-feature{grid-template-columns:1fr 1fr}.section-builder-feature.image-right .section-builder-feature-image{order:2}.section-builder-split-quote{grid-template-columns:.9fr 1.1fr;gap:clamp(3rem,8vw,7rem)}.section-builder-gallery{grid-template-columns:repeat(2,1fr)}}
@media(min-width:64rem){.section-builder-card-grid{grid-template-columns:repeat(3,1fr)}.section-builder-gallery{grid-template-columns:repeat(3,1fr)}}
</style>

---
import { getCollection } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';
import CottageCard from './CottageCard.astro';
import Callout from './Callout.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';

interface Props { sections?: any[] }
const { sections = [] } = Astro.props;
const visibleSections = sections.filter(section => section.enabled !== false);
const cottages=(await getCollection('cottages')).filter(c=>c.data.available).sort((a,b)=>a.data.name.localeCompare(b.data.name));
const directionsUrl=`https://www.google.com/maps/dir/?api=1&destination=${site.coordinates.latitude},${site.coordinates.longitude}`;
const mapUrl=`https://www.google.com/maps?q=${site.coordinates.latitude},${site.coordinates.longitude}&z=15&output=embed`;
const tokens:Record<string,string>={
  email:site.email,
  telephoneHref:site.telephoneHref,
  telephoneDisplay:site.telephoneDisplay,
  street:site.address.street,
  locality:site.address.locality,
  island:site.address.island,
  postcode:site.address.postcode,
  directionsUrl
};
const resolve=(value?:string)=>value?.replace(/\{\{(\w+)\}\}/g,(_,key)=>tokens[key]??`{{${key}}}`)??'';
const paragraphs = (text?: string) => resolve(text).split(/\n\s*\n/).filter(Boolean);
const sectionTheme = (section:any,index:number) => {
  if(section.theme === 'green') return 'green';
  if(section.theme === 'cream') return '';
  if(section.theme === 'paper') return 'paper';
  return index % 2 === 0 ? 'paper' : '';
};
const widthClass = (section:any) => section.width === 'narrow' ? 'section-builder-narrow' : section.width === 'wide' ? 'section-builder-wide' : '';
const externalAttrs = (external?:boolean) => external ? {target:'_blank',rel:'noopener'} : {};
---
{visibleSections.map((section,index) => {
  const theme = sectionTheme(section,index);
  const width = widthClass(section);
  const eyebrowClass = theme === 'green' ? 'eyebrow eyebrow-light' : 'eyebrow';

  if(section.type === 'cta') return (
    <Callout
      title={resolve(section.title)}
      text={resolve(section.text)}
      href={resolve(section.buttonUrl) || '/contact/'}
      label={resolve(section.buttonLabel) || 'Find out more'}
      secondaryHref={resolve(section.secondaryButtonUrl) || undefined}
      secondaryLabel={resolve(section.secondaryButtonLabel) || undefined}
    />
  );

  if(section.type === 'splitQuote') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-split-quote',width]}>
        <div>
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          <div class:list={['intro-copy',theme === 'green' && 'on-green-copy']}>{paragraphs(section.text).map(text=><p>{text}</p>)}</div>
        </div>
        <aside class:list={['section-builder-quote-card',theme === 'green' && 'on-green-card']}>
          <blockquote>“{resolve(section.quote)}”</blockquote>
          {section.attribution && <p>{resolve(section.attribution)}</p>}
        </aside>
      </div>
    </section>
  );

  if(section.type === 'featureStrip') return (
    <section class:list={['section-builder-feature-strip-section',theme]} aria-label={resolve(section.title)}>
      <div class:list={['wrap','section-builder-feature-strip',width]}>
        <h2 class="section-builder-visually-hidden">{resolve(section.title)}</h2>
        {section.items?.map((item:any)=><article>
          {item.icon && <span class="section-builder-feature-strip-icon"><Icon name={item.icon} size={25}/></span>}
          <div>
            <strong>{resolve(item.title)}</strong>
            {item.text && <span>{resolve(item.text)}</span>}
          </div>
        </article>)}
      </div>
    </section>
  );

  if(section.type === 'cottageListing') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text=><p class="lede">{text}</p>)}
        </header>
        <div class="cottage-grid">{cottages.map(c=><CottageCard cottage={c}/>)}</div>
      </div>
    </section>
  );

  if(section.type === 'notice') return (
    <section class:list={['section-tight',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        <div class="notice">{section.title && <strong>{resolve(section.title)} </strong>}{resolve(section.text)}</div>
      </div>
    </section>
  );

  if(section.type === 'locationMap') return (
    <section class:list={['section',theme]} id="map">
      <div class:list={['wrap',width]}>
        {(section.eyebrow || section.title || section.text) && <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          {section.title && <h2>{resolve(section.title)}</h2>}
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>}
        <div class="map-card">
          <iframe src={mapUrl} title="Map showing Les Buttes Holiday Cottages" loading="lazy"></iframe>
          <div class="map-card-content"><strong>Les Buttes Holiday Cottages</strong><p>{site.address.street}, {site.address.locality}, {site.address.island} {site.address.postcode}</p><a class="button" href={directionsUrl} target="_blank" rel="noopener">Start directions<Icon name="external" size={17}/></a></div>
        </div>
      </div>
    </section>
  );

  if(section.type === 'steps') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.items?.length > 0 && <ol class="directions">{section.items.map((item:any)=><li><strong>{resolve(item.title)}</strong>{item.text&&<> {resolve(item.text)}</>}</li>)}</ol>}
      </div>
    </section>
  );

  if(section.type === 'feature') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-feature',width,section.imagePosition === 'right' && 'image-right']}>
        {section.image && <div class="section-builder-feature-image"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[480,768,1100,1440]} sizes="(max-width: 768px) 100vw, 54vw"/></div>}
        <div class="section-builder-copy">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p>{text}</p>)}
          {section.buttonLabel && section.buttonUrl && <a class:list={['button',theme === 'green' && 'button-light']} href={resolve(section.buttonUrl)} {...externalAttrs(section.buttonExternal)}>{resolve(section.buttonLabel)}<Icon name={section.buttonExternal?'external':'arrow'} size={18}/></a>}
        </div>
      </div>
    </section>
  );

  if(section.type === 'image') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-image-wrap',width]}>
        {(section.eyebrow || section.title || section.text) && <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          {section.title && <h2>{resolve(section.title)}</h2>}
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>}
        {section.image && <figure class="section-builder-image"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[640,960,1280,1600]} sizes="100vw"/>{section.imageCaption && <figcaption>{resolve(section.imageCaption)}</figcaption>}</figure>}
      </div>
    </section>
  );

  if(section.type === 'cards' || section.type === 'iconCards') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.items?.length > 0 && <div class:list={['section-builder-card-grid',section.type === 'iconCards' && 'section-builder-card-grid-icons']}>{section.items.map((item:any) => <article class:list={['section-builder-card',theme === 'green' && 'on-green',item.image && 'has-image']}>
          {item.image && <div class="section-builder-card-image"><ResponsiveImage src={item.image} alt={resolve(item.imageAlt)} widths={[360,560,760]} sizes="(max-width: 768px) 100vw, 33vw"/></div>}
          <div class="section-builder-card-content">
            {item.kicker && <span class="section-builder-kicker">{resolve(item.kicker)}</span>}
            {section.type === 'iconCards' && item.icon && !item.linkLabel && <span class="section-builder-icon"><Icon name={item.icon} size={26}/></span>}
            <h3>{resolve(item.title)}</h3>
            {item.text && <p>{resolve(item.text)}</p>}
            {item.linkLabel && item.linkUrl && (
              section.type === 'iconCards'
                ? <a class="section-builder-pill" href={resolve(item.linkUrl)} {...externalAttrs(item.external)}><span>{resolve(item.linkLabel)}</span><span class="section-builder-pill-icon"><Icon name={item.icon ?? (item.external?'external':'arrow')} size={19}/></span></a>
                : <a class="text-link" href={resolve(item.linkUrl)} {...externalAttrs(item.external)}>{resolve(item.linkLabel)}<Icon name={item.external?'external':'arrow'} size={17}/></a>
            )}
          </div>
        </article>)}</div>}
        {section.buttonLabel && section.buttonUrl && <div class="section-builder-section-action"><a class:list={['button',theme === 'green' && 'button-light']} href={resolve(section.buttonUrl)} {...externalAttrs(section.buttonExternal)}>{resolve(section.buttonLabel)}<Icon name={section.buttonExternal?'external':'arrow'} size={18}/></a></div>}
      </div>
    </section>
  );

  if(section.type === 'list') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <h2>{resolve(section.title)}</h2>
        {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        {section.listItems?.length > 0 && <ul class="section-builder-list">{section.listItems.map((item:string) => <li>{resolve(item)}</li>)}</ul>}
      </div>
    </section>
  );

  if(section.type === 'gallery') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.galleryImages?.length > 0 && <div class="section-builder-gallery">{section.galleryImages.map((item:any,imageIndex:number) => {
          const dialogId=`gallery-${index}-${imageIndex}`;
          const label=resolve(item.caption || item.alt || 'gallery image');
          return <figure>
            <button class="section-builder-gallery-trigger" type="button" data-gallery-open={dialogId} aria-label={`Open ${label}`}>
              <ResponsiveImage src={item.image} alt={resolve(item.alt)} widths={[480,768,1100]} sizes="(max-width: 768px) 100vw, 33vw"/>
            </button>
            {item.caption && <figcaption>{resolve(item.caption)}</figcaption>}
            <dialog id={dialogId} class="section-builder-lightbox">
              <button class="section-builder-lightbox-close" type="button" data-gallery-close aria-label="Close image">×</button>
              <ResponsiveImage src={item.image} alt={resolve(item.alt)} widths={[960,1280,1600]} sizes="92vw"/>
              {item.caption && <p>{resolve(item.caption)}</p>}
            </dialog>
          </figure>
        })}</div>}
      </div>
    </section>
  );

  if(section.type === 'quote') return section.image ? (
    <section class="section-builder-quote-image">
      <div class="section-builder-quote-background"><ResponsiveImage src={section.image} alt="" widths={[640,960,1280,1600]} sizes="100vw"/></div>
      <div class="section-builder-quote-image-overlay" aria-hidden="true"></div>
      <div class:list={['wrap','section-builder-quote','section-builder-quote-on-image',width]}>
        {section.eyebrow && <p class="eyebrow eyebrow-light">{resolve(section.eyebrow)}</p>}
        <blockquote>“{resolve(section.quote ?? section.text)}”</blockquote>
        {section.attribution && <p class="section-builder-attribution">{resolve(section.attribution)}</p>}
      </div>
    </section>
  ) : (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-quote',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <blockquote>“{resolve(section.quote ?? section.text)}”</blockquote>
        {section.attribution && <p class="section-builder-attribution">{resolve(section.attribution)}</p>}
      </div>
    </section>
  );

  if(section.type === 'map') return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap',width]}>
        <header class="section-heading">
          {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
          <h2>{resolve(section.title)}</h2>
          {paragraphs(section.text).map(text => <p class="lede">{text}</p>)}
        </header>
        {section.image && <div class="section-builder-map"><ResponsiveImage src={section.image} alt={resolve(section.imageAlt)} widths={[640,960,1280,1600]} sizes="100vw"/></div>}
      </div>
    </section>
  );

  return (
    <section class:list={['section',theme]}>
      <div class:list={['wrap','section-builder-narrow',width]}>
        {section.eyebrow && <p class={eyebrowClass}>{resolve(section.eyebrow)}</p>}
        <h2>{resolve(section.title)}</h2>
        <div class="prose">{paragraphs(section.text).map(text => <p>{text}</p>)}</div>
        {section.buttonLabel && section.buttonUrl && <a class:list={['button',theme === 'green' && 'button-light']} href={resolve(section.buttonUrl)} {...externalAttrs(section.buttonExternal)}>{resolve(section.buttonLabel)}<Icon name={section.buttonExternal?'external':'arrow'} size={18}/></a>}
      </div>
    </section>
  );
})}

<script is:inline>
document.addEventListener('click', function(event) {
  const target = event.target instanceof Element ? event.target : null;
  const openButton = target?.closest('[data-gallery-open]');
  if (openButton) {
    const id = openButton.getAttribute('data-gallery-open');
    const dialog = id ? document.getElementById(id) : null;
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
    return;
  }
  const closeButton = target?.closest('[data-gallery-close]');
  if (closeButton) {
    const dialog = closeButton.closest('dialog');
    if (dialog instanceof HTMLDialogElement) dialog.close();
    return;
  }
  if (target instanceof HTMLDialogElement) target.close();
});
</script>

<style>
.section-builder-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.section-builder-narrow{max-width:56rem}.section-builder-wide{--wrap:88rem;max-width:88rem}.section-builder-feature{display:grid;gap:clamp(2rem,6vw,5rem);align-items:center}.section-builder-feature-image{overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius);box-shadow:var(--shadow)}.section-builder-feature-image picture,.section-builder-feature-image img{width:100%;height:100%;object-fit:cover}.section-builder-copy{max-width:42rem}.section-builder-copy>p:not(.eyebrow){color:var(--soft);font-size:1.06rem}.green .section-builder-copy>p:not(.eyebrow),.green .lede{color:#ffffffc7}.section-builder-copy .button{margin-top:.5rem}.section-builder-split-quote{display:grid;gap:2.5rem;align-items:center}.section-builder-split-quote>div>h2{max-width:13ch}.on-green-copy{color:#ffffffc7}.section-builder-quote-card{padding:clamp(2rem,5vw,4rem);color:#fff;background:#285545;border-radius:var(--radius)}.section-builder-quote-card blockquote{margin:0 0 2rem;font:500 clamp(1.9rem,4vw,3.1rem)/1.18 var(--display)}.section-builder-quote-card p{margin:0;color:#ffffffd1;font-size:1.02rem}.section-builder-quote-card.on-green-card{color:var(--ink);background:var(--paper)}.section-builder-quote-card.on-green-card p{color:var(--soft)}.section-builder-image-wrap{display:grid;justify-items:center}.section-builder-image{width:min(100%,72rem);margin:0}.section-builder-image picture,.section-builder-image img{width:100%;height:auto;border-radius:var(--radius)}.section-builder-image figcaption{margin-top:.7rem;color:var(--soft);font-size:.85rem;text-align:center}
.section-builder-feature-strip-section{border-block:1px solid var(--line)}.section-builder-feature-strip{display:grid}.section-builder-feature-strip article{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:start;padding:1.25rem 0}.section-builder-feature-strip article+article{border-top:1px solid var(--line)}.section-builder-feature-strip-icon{display:grid;width:2.5rem;height:2.5rem;place-items:center;color:var(--green)}.green .section-builder-feature-strip-icon{color:var(--gold2)}.section-builder-feature-strip strong{display:block;margin-bottom:.1rem;font:600 .96rem var(--body)}.section-builder-feature-strip span{display:block;color:var(--soft);font-size:.8rem;line-height:1.45}.green .section-builder-feature-strip span{color:#ffffffba}
.section-builder-card-grid{display:grid;gap:1rem}.section-builder-card{display:flex;flex-direction:column;overflow:hidden;padding:0;background:var(--paper);border:1px solid var(--line);border-radius:.85rem}.section-builder-card-content{display:flex;flex:1;flex-direction:column;padding:1.5rem}.section-builder-card-image{overflow:hidden;aspect-ratio:16/10;background:var(--pale)}.section-builder-card-image picture,.section-builder-card-image img{display:block;width:100%;height:100%;object-fit:cover}.section-builder-card.on-green{background:#ffffff12;border-color:#ffffff2b}.section-builder-card h3{font:700 1.05rem var(--body);letter-spacing:0}.section-builder-card p{color:var(--soft);white-space:pre-line}.section-builder-card.on-green p{color:#ffffffc7}.section-builder-card.on-green .text-link{color:#fff}.section-builder-kicker{display:block;margin-bottom:1rem;color:var(--gold);font:1.2rem var(--display)}.section-builder-icon{display:grid;width:3rem;height:3rem;margin-bottom:1.1rem;place-items:center;color:var(--green);background:var(--pale);border-radius:50%}.section-builder-card.on-green .section-builder-icon{color:var(--deep);background:#ffffffe8}.section-builder-pill{display:inline-flex;align-items:center;justify-content:space-between;gap:.8rem;width:max-content;max-width:100%;margin-top:auto;padding:.55rem .55rem .55rem 1rem;color:var(--green);background:var(--cream);border:1px solid #194c3d33;border-radius:999px;font-size:.92rem;font-weight:700;line-height:1.25;text-decoration:none;transition:background .2s,border-color .2s,transform .2s}.section-builder-pill:hover{background:var(--pale);border-color:#194c3d66;transform:translateY(-1px)}.section-builder-pill-icon{display:grid;flex:0 0 2.1rem;width:2.1rem;height:2.1rem;place-items:center;color:#fff;background:var(--green);border-radius:50%}.section-builder-card.on-green .section-builder-pill{color:var(--deep);background:#fff}.section-builder-section-action{margin-top:1.75rem}
.section-builder-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.75rem;margin:2rem 0 0;padding:0;list-style:none}.section-builder-list li{padding:1rem 1.15rem;background:var(--paper);border:1px solid var(--line);border-radius:.75rem;font-weight:600}.paper .section-builder-list li{background:var(--cream)}.green .section-builder-list li{background:#ffffff12;border-color:#ffffff2b}
.section-builder-gallery{display:grid;gap:.8rem}.section-builder-gallery figure{position:relative;overflow:hidden;min-height:16rem;margin:0;background:var(--pale);border-radius:.8rem}.section-builder-gallery-trigger{display:block;width:100%;height:100%;min-height:16rem;padding:0;border:0;background:transparent;cursor:zoom-in}.section-builder-gallery-trigger picture,.section-builder-gallery-trigger img{width:100%;height:100%;object-fit:cover}.section-builder-gallery figcaption{position:absolute;right:.6rem;bottom:.6rem;left:.6rem;padding:.55rem .7rem;pointer-events:none;color:#fff;background:linear-gradient(90deg,#000a,#0002);border-radius:.4rem;font-size:.8rem}.section-builder-lightbox{width:min(94vw,88rem);max-height:92vh;padding:0;border:0;background:#0c1713;box-shadow:0 30px 90px #0008}.section-builder-lightbox::backdrop{background:#07110de8}.section-builder-lightbox picture,.section-builder-lightbox img{display:block;width:100%;max-height:82vh;object-fit:contain}.section-builder-lightbox p{margin:0;padding:.8rem 1rem;color:#fff;text-align:center}.section-builder-lightbox-close{position:absolute;z-index:3;top:.65rem;right:.65rem;display:grid;width:2.5rem;height:2.5rem;place-items:center;color:#fff;background:#0b231dcc;border:1px solid #ffffff66;border-radius:50%;font-size:1.5rem;cursor:pointer}
.section-builder-quote{max-width:58rem;text-align:center}.section-builder-quote blockquote{margin:0;font:500 clamp(2rem,5vw,3.8rem)/1.18 var(--display)}.section-builder-attribution{margin:1.5rem 0 0;color:var(--soft);font-weight:700}.green .section-builder-attribution{color:#ffffffbf}.section-builder-quote-image{position:relative;display:grid;min-height:clamp(23rem,40vw,34rem);overflow:hidden;color:#fff;background:var(--deep)}.section-builder-quote-background,.section-builder-quote-background picture,.section-builder-quote-background img{position:absolute;inset:0;width:100%;height:100%}.section-builder-quote-background img{object-fit:cover}.section-builder-quote-image-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#061d18b8,#10251c7d)}.section-builder-quote-on-image{position:relative;z-index:2;align-self:center;padding-block:clamp(4rem,8vw,7rem)}.section-builder-quote-on-image blockquote{max-width:24ch;margin-inline:auto}.section-builder-quote-on-image .section-builder-attribution{color:#ffffffcf}
.section-builder-map{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}.section-builder-map picture,.section-builder-map img{width:100%;height:auto}.green .text-link{color:#fff}

---
import{getCollection,getEntry,render}from'astro:content';import BaseLayout from'../layouts/BaseLayout.astro';import ResponsiveImage from'../components/ResponsiveImage.astro';import CottageCard from'../components/CottageCard.astro';import Callout from'../components/Callout.astro';import Icon from'../components/Icon.astro';
const page=await getEntry('pages','home');if(!page)throw new Error('Missing home');const{Content}=await render(page);const cottages=(await getCollection('cottages')).filter(c=>c.data.status==='available').sort((a,b)=>a.data.name.localeCompare(b.data.name));
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow eyebrow-light">{page.data.eyebrow}</p><h1>{page.data.title}</h1><p class="lede">{page.data.intro}</p><div class="hero-actions"><a class="button button-light" href="/cottages/">Explore our cottages<Icon name="arrow" size={18}/></a><a class="button button-outline" href="/find-us/">Find us</a></div></div><div class="hero-image"><ResponsiveImage src={page.data.heroImage ?? '/src/assets/images/cottages/honeysuckle/garden.jpg'} alt={page.data.heroAlt ?? 'The private garden and conservatories at Honeysuckle Cottage'} widths={[640,960,1280,1440]} sizes="(max-width:1024px) 100vw,55vw" loading="eager" fetchpriority="high"/><p class="hero-note"><strong>Family-run since 1981</strong>Two individual cottages within a restored 16th-century Guernsey farm.</p></div></div></section>
<section class="section wrap intro-split"><div><p class="eyebrow">A gentler pace of island life</p><h2>A warm welcome, in a place with character</h2></div><div class="intro-copy"><Content/><a class="text-link" href="/about/">Our story<Icon name="arrow" size={18}/></a></div></section>
<section class="section paper"><div class="wrap"><header class="section-heading"><p class="eyebrow">Our cottages</p><h2>Find your home from home</h2><p class="lede">Choose charming Geranium for up to four guests or spacious Honeysuckle for a family or group of up to six.</p></header><div class="cottage-grid">{cottages.map(c=><CottageCard cottage={c}/>)}</div></div></section>
<section class="section green"><div class="wrap"><header class="section-heading"><p class="eyebrow eyebrow-light">At a glance</p><h2>The little things are taken care of</h2></header><div class="promise"><article class="promise-card"><h3>Ready for your arrival</h3><p>Fresh linen, towels, tea, coffee, and delicious local milk and butter from the island’s famous Guernsey cows.</p></article><article class="promise-card"><h3>Comfort included</h3><p>Heating, electricity and Wi-Fi are included, so there are no unwelcome surprises during your stay.</p></article><article class="promise-card"><h3>Close to the coast</h3><p>West-coast beaches, south-coast cliff paths and village amenities are all within easy reach.</p></article></div></div></section>
<section class="section wrap intro-split"><div><p class="eyebrow">Explore Guernsey</p><h2>Wild coastline, quiet lanes and island stories</h2></div><div class="intro-copy"><p>Fill your days with sandy beaches, cliff-top walks, historic sites and leisurely meals — or simply choose a favourite corner of the garden and do very little at all.</p><a class="text-link" href="/explore-guernsey/">Things to do in Guernsey<Icon name="arrow" size={18}/></a></div></section><Callout title="Ready to plan your Guernsey stay?" text="See each cottage in detail, then check live availability and reserve securely through Airbnb." href="/cottages/geranium/" label="Discover Geranium" secondaryHref="/cottages/honeysuckle/" secondaryLabel="Discover Honeysuckle"/></BaseLayout>

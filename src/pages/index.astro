---
import{getCollection,getEntry,render}from'astro:content';import BaseLayout from'../layouts/BaseLayout.astro';import HeroMedia from'../components/HeroMedia.astro';import CottageCard from'../components/CottageCard.astro';import Callout from'../components/Callout.astro';import Icon from'../components/Icon.astro';
const page=await getEntry('pages','home');if(!page)throw new Error('Missing home');const{Content}=await render(page);const cottages=(await getCollection('cottages')).filter(c=>c.data.available).sort((a,b)=>a.data.name.localeCompare(b.data.name));
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}>
<section class="home-hero">
  <HeroMedia mediaType={page.data.heroMediaType} imageSrc={page.data.heroImage ?? '/src/assets/images/cottages/honeysuckle/exterior.jpg'} imageAlt={page.data.heroAlt ?? 'The granite buildings at Les Buttes Holiday Cottages'} pan={page.data.heroPan} videoSrc={page.data.heroVideo} posterSrc={page.data.heroPoster} class="home-hero-image" widths={[640,960,1280,1600,1920]} sizes="100vw" loading="eager" fetchpriority="high" decorative />
  <div class="wrap home-hero-inner"><div class="home-hero-copy"><p class="eyebrow eyebrow-light">{page.data.eyebrow}</p><h1>{page.data.title}</h1><p class="lede">{page.data.intro}</p><div class="hero-actions"><a class="button button-light" href="/cottages/">Explore our cottages</a><a class="button button-outline" href="/cottages/">Check availability</a></div></div></div>
</section>
<div class="wrap home-facts" aria-label="Les Buttes at a glance"><div><strong>Two cottages</strong><span>Each with its own character</span></div><div><strong>Sleeps 4–6</strong><span>For couples and families</span></div><div><strong>Private gardens</strong><span>Peaceful, sheltered spaces</span></div><div><strong>Close to the coast</strong><span>Beaches and cliff paths nearby</span></div></div>
<section class="section home-welcome"><div class="wrap home-welcome-grid"><div><p class="eyebrow">{page.data.welcomeEyebrow ?? 'Welcome to Les Buttes'}</p><h2>{page.data.welcomeTitle ?? 'A traditional Guernsey welcome'}</h2><div class="intro-copy"><Content/></div></div><aside class="welcome-quote"><blockquote>“{page.data.welcomeQuote ?? 'A peaceful place to slow down, breathe in the sea air and enjoy Guernsey at your own pace.'}”</blockquote><p>{page.data.welcomeNote ?? 'Your cottage will be prepared before arrival, with linen, towels and a small welcome supply of tea, coffee and milk.'}</p></aside></div></section>
<section class="section paper"><div class="wrap"><header class="section-heading"><p class="eyebrow">Our cottages</p><h2>Find your home from home</h2><p class="lede">Choose charming Geranium for up to four guests or spacious Honeysuckle for a family or group of up to six.</p></header><div class="cottage-grid">{cottages.map(c=><CottageCard cottage={c}/>)}</div></div></section>
<section class="section green"><div class="wrap"><header class="section-heading"><p class="eyebrow eyebrow-light">At a glance</p><h2>The little things are taken care of</h2></header><div class="promise"><article class="promise-card"><h3>Ready for your arrival</h3><p>Fresh linen, towels, tea, coffee, and delicious local milk and butter from the island’s famous Guernsey cows.</p></article><article class="promise-card"><h3>Comfort included</h3><p>Heating, electricity and Wi-Fi are included, so there are no unwelcome surprises during your stay.</p></article><article class="promise-card"><h3>Close to the coast</h3><p>West-coast beaches, south-coast cliff paths and village amenities are all within easy reach.</p></article></div></div></section>
<section class="section wrap intro-split"><div><p class="eyebrow">Explore Guernsey</p><h2>Wild coastline, quiet lanes and island stories</h2></div><div class="intro-copy"><p>Fill your days with sandy beaches, cliff-top walks, historic sites and leisurely meals — or simply choose a favourite corner of the garden and do very little at all.</p><a class="text-link" href="/explore-guernsey/">Things to do in Guernsey<Icon name="arrow" size={18}/></a></div></section><Callout title="Ready to plan your Guernsey stay?" text="See each cottage in detail, then check live availability and reserve securely through Airbnb." href="/cottages/geranium/" label="Discover Geranium" secondaryHref="/cottages/honeysuckle/" secondaryLabel="Discover Honeysuckle"/></BaseLayout>

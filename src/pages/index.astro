---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import PageSections from '../components/PageSections.astro';
import Icon from '../components/Icon.astro';

const page = await getEntry('pages','home');
if (!page) throw new Error('Missing home');
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}>
  <section class="home-hero">
    <HeroMedia
      mediaType={page.data.heroMediaType}
      imageSrc={page.data.heroImage ?? '/src/assets/images/cottages/geranium/exterior.jpg'}
      imageAlt={page.data.heroAlt ?? 'The granite buildings at Les Buttes Holiday Cottages'}
      pan={page.data.heroPan}
      videoSrc={page.data.heroVideo}
      posterSrc={page.data.heroPoster}
      class="home-hero-image"
      widths={[640,960,1280,1600,1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decorative
    />
    <div class="wrap home-hero-inner">
      <div class="home-hero-copy">
        <p class="eyebrow eyebrow-light">{page.data.eyebrow}</p>
        <h1>{page.data.title}</h1>
        <p class="lede">{page.data.intro}</p>
        <div class="hero-actions">
          {page.data.heroPrimaryLabel && page.data.heroPrimaryUrl && (
            <a class="button button-light" href={page.data.heroPrimaryUrl}>{page.data.heroPrimaryLabel}<Icon name="arrow" size={17}/></a>
          )}
          {page.data.heroSecondaryLabel && page.data.heroSecondaryUrl && (
            <a class="button button-outline" href={page.data.heroSecondaryUrl}>{page.data.heroSecondaryLabel}</a>
          )}
        </div>
      </div>
    </div>
  </section>
  <PageSections sections={page.data.sections}/>
</BaseLayout>

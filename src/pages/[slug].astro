---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';

export async function getStaticPaths(){
  const pages=(await getCollection('subpages')).filter(p=>p.data.published);
  return pages.map(page=>({params:{slug:page.data.slug},props:{page}}));
}

const {page}=Astro.props;
const p=page.data;
const hasHero=Boolean(p.heroImage||p.heroVideo);
const paragraphs=(text?:string)=>text?.split(/\n\s*\n/).filter(Boolean)??[];
---
<BaseLayout title={p.seo.title} description={p.seo.description}>
  {hasHero ? (
    <PageIntro eyebrow={p.eyebrow} title={p.title} intro={p.intro} mediaType={p.heroMediaType} imageSrc={p.heroImage} imageAlt={p.heroAlt} pan={p.heroPan} videoSrc={p.heroVideo} posterSrc={p.heroPoster}/>
  ) : (
    <div class="wrap"><PageIntro eyebrow={p.eyebrow} title={p.title} intro={p.intro}/></div>
  )}

  {p.sections.filter(section=>section.enabled!==false).map((section,index)=>{
    const isPaper=index%2===0;
    if(section.type==='feature') return (
      <section class:list={['section',isPaper&&'paper']}>
        <div class:list={['wrap','subpage-feature',section.imagePosition==='right'&&'image-right']}>
          {section.image&&<div class="subpage-feature-image"><ResponsiveImage src={section.image} alt={section.imageAlt??''} widths={[480,768,1100]} sizes="(max-width: 768px) 100vw, 50vw"/></div>}
          <div class="subpage-copy">
            {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.title}</h2>
            {paragraphs(section.text).map(text=><p>{text}</p>)}
          </div>
        </div>
      </section>
    );

    if(section.type==='cards') return (
      <section class:list={['section',isPaper&&'paper']}>
        <div class="wrap">
          <header class="section-heading">
            {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.title}</h2>
            {paragraphs(section.text).map(text=><p class="lede">{text}</p>)}
          </header>
          {section.items?.length>0&&<div class="subpage-card-grid">{section.items.map(item=><article class="info-card"><h3>{item.title}</h3>{item.text&&<p>{item.text}</p>}</article>)}</div>}
        </div>
      </section>
    );

    if(section.type==='list') return (
      <section class:list={['section',isPaper&&'paper']}>
        <div class="wrap subpage-narrow">
          {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
          <h2>{section.title}</h2>
          {paragraphs(section.text).map(text=><p class="lede">{text}</p>)}
          {section.listItems?.length>0&&<ul class="subpage-list">{section.listItems.map(item=><li>{item}</li>)}</ul>}
        </div>
      </section>
    );

    if(section.type==='map') return (
      <section class:list={['section',isPaper&&'paper']}>
        <div class="wrap subpage-narrow">
          {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
          <h2>{section.title}</h2>
          {paragraphs(section.text).map(text=><p class="lede">{text}</p>)}
          {section.image&&<div class="subpage-map"><ResponsiveImage src={section.image} alt={section.imageAlt??''} widths={[640,960,1280]} sizes="100vw"/></div>}
        </div>
      </section>
    );

    return (
      <section class:list={['section',isPaper&&'paper']}>
        <div class="wrap subpage-narrow">
          {section.eyebrow&&<p class="eyebrow">{section.eyebrow}</p>}
          <h2>{section.title}</h2>
          <div class="prose">{paragraphs(section.text).map(text=><p>{text}</p>)}</div>
        </div>
      </section>
    );
  })}
</BaseLayout>

<style>
.subpage-narrow{max-width:56rem}
.subpage-feature{display:grid;gap:clamp(2rem,6vw,5rem);align-items:center}
.subpage-feature-image{overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius);box-shadow:var(--shadow)}
.subpage-feature-image picture,.subpage-feature-image img{width:100%;height:100%;object-fit:cover}
.subpage-copy{max-width:42rem}
.subpage-copy>p:not(.eyebrow){color:var(--soft);font-size:1.06rem}
.subpage-card-grid{display:grid;gap:1rem}
.subpage-card-grid .info-card h3{font:700 1.05rem var(--body);letter-spacing:0}
.subpage-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));gap:.75rem;margin:2rem 0 0;padding:0;list-style:none}
.subpage-list li{padding:1rem 1.15rem;background:var(--paper);border:1px solid var(--line);border-radius:.75rem;font-weight:600}
.paper .subpage-list li{background:var(--cream)}
.subpage-map{overflow:hidden;margin-top:2rem;border:1px solid var(--line);border-radius:var(--radius)}
@media(min-width:48rem){.subpage-card-grid{grid-template-columns:repeat(2,1fr)}.subpage-feature{grid-template-columns:1fr 1fr}.subpage-feature.image-right .subpage-feature-image{order:2}}
</style>

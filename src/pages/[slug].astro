---
import { getCollection } from 'astro:content';
import ContentPageTemplate from '../components/templates/ContentPageTemplate.astro';

export async function getStaticPaths(){
  const pages=(await getCollection('subpages')).filter(p=>p.data.published);
  return pages.map(page=>({params:{slug:page.data.slug},props:{page}}));
}

const {page}=Astro.props;
---
<ContentPageTemplate pageData={page.data}/>

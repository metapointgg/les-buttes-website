---
import{getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import Callout from'../../components/Callout.astro';import site from'../../data/site.json';const page=await getEntry('pages','find-us');if(!page)throw new Error('Missing');const{Content}=await render(page);const map=`https://www.google.com/maps?q=${site.coordinates.latitude},${site.coordinates.longitude}&z=15&output=embed`;const directions=`https://www.google.com/maps/dir/?api=1&destination=${site.coordinates.latitude},${site.coordinates.longitude}`;
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><div class="wrap"><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}/></div><section class="section-tight paper"><div class="wrap content-grid"><div><p class="eyebrow">Getting here</p><h2>Close to the coast, easy to reach</h2><div class="prose"><Content/></div><div class="notice"><strong>Before you set out:</strong> save or screenshot these final directions. Rural lanes can be narrow and mobile reception may vary.</div></div><aside><div class="sticky-card"><h2>Les Buttes Holiday Cottages</h2><address>{site.address.street}<br/>{site.address.locality}<br/>{site.address.island}<br/>{site.address.postcode}</address><a class="text-link" href={directions} target="_blank" rel="noopener">Open Google Maps ↗</a></div></aside></div></section><section class="section wrap"><div class="map-card"><iframe src={map} title="Map showing Les Buttes Holiday Cottages" loading="lazy"></iframe><div class="map-card-content"><strong>Les Buttes Holiday Cottages</strong><p>Rue des Raies, St Pierre du Bois, Guernsey GY7 9SF</p><a class="button" href={directions} target="_blank" rel="noopener">Start directions</a></div></div></section><section class="section-tight wrap"><header class="section-heading"><p class="eyebrow">Recommended final approach</p><h2>From the airport or harbour</h2></header><ol class="directions"><li><strong>Head towards St Pierre du Bois.</strong> From the harbour, follow signs for the airport and continue past it. From the airport, turn right onto the main road.</li><li><strong>Continue to the village shops.</strong> Enter the 25 mph area and pass the Morrisons shop on your right.</li><li><strong>Bear left at the filter.</strong> About 100 metres beyond the shop, bear left at the filter-in-turn junction.</li><li><strong>Take the first small lane on the left.</strong> Look for the Les Buttes sign. If you reach St Peter’s Church, you have gone slightly too far.</li></ol></section><section class="section wrap"><div class="info-grid"><article class="info-card"><h2>Flying</h2><p>Guernsey Airport is approximately two miles away.</p><a href="https://www.aurigny.com/">Aurigny flights ↗</a></article><article class="info-card"><h2>By sea</h2><p>Ferries connect Guernsey with the UK and France.</p><a href="https://www.condorferries.co.uk/">Condor Ferries ↗</a></article><article class="info-card"><h2>Getting around</h2><p>Bus stops are close by, and cars and bicycles can be hired.</p><a href="https://www.buses.gg/">Guernsey buses ↗</a></article></div></section><Callout title="Let us help with your arrival" text="If you would like to confirm the final approach or have an accessibility question, contact us before you travel." href="/contact/" label="Contact us"/></BaseLayout>

---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PageSections from '../../components/PageSections.astro';

const page=await getEntry('pages','about');
if(!page) throw new Error('Missing');
const sections:any[]=page.data.sections??[];
const storySections=sections.filter(section=>section.type==='feature'&&section.enabled!==false);
const timeline:any=sections.find(section=>section.type==='cards'&&section.enabled!==false&&section.items?.length);
const closingSections=sections.filter(section=>['quote','cta'].includes(section.type)&&section.enabled!==false);
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}>
  <PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} mediaType={page.data.heroMediaType} imageSrc={page.data.heroImage} imageAlt={page.data.heroAlt} pan={page.data.heroPan} videoSrc={page.data.heroVideo} posterSrc={page.data.heroPoster}/>
  <PageSections sections={storySections}/>

  {timeline&&<section class="section cream story-timeline-section">
    <div class="wrap section-builder-wide">
      <header class="section-heading story-timeline-heading">
        <p class="eyebrow">Our story</p>
        <h2>{timeline.title}</h2>
      </header>
      <ol class="story-timeline">
        {timeline.items.map((item:any)=><li>
          <span class="story-timeline-date">{item.kicker}</span>
          <div>
            <h3>{item.title}</h3>
            {item.text&&<p>{item.text}</p>}
          </div>
        </li>)}
      </ol>
    </div>
  </section>}

  <PageSections sections={closingSections}/>
</BaseLayout>

<style>
.story-timeline-heading{max-width:42rem}
.story-timeline{position:relative;display:grid;gap:0;margin:2.6rem 0 0;padding:0;list-style:none}
.story-timeline::before{content:"";position:absolute;top:0;bottom:0;left:.42rem;width:1px;background:var(--line)}
.story-timeline li{position:relative;display:grid;grid-template-columns:minmax(7rem,9rem) 1fr;gap:1.3rem;padding:0 0 2.5rem 1.7rem}
.story-timeline li::before{content:"";position:absolute;top:.45rem;left:0;width:.85rem;height:.85rem;background:var(--cream);border:2px solid var(--gold);border-radius:50%}
.story-timeline-date{color:var(--gold);font:600 .8rem var(--body);letter-spacing:.09em;text-transform:uppercase}
.story-timeline h3{margin:0 0 .45rem;font:500 clamp(1.55rem,2.5vw,2.2rem)/1.15 var(--display)}
.story-timeline p{max-width:42rem;margin:0;color:var(--soft)}
@media(min-width:52rem){.story-timeline{grid-template-columns:repeat(3,1fr);gap:2.5rem;padding-top:1.5rem}.story-timeline::before{top:1.9rem;right:0;bottom:auto;left:0;width:auto;height:1px}.story-timeline li{grid-template-columns:1fr;gap:.65rem;padding:2rem 1rem 0 0}.story-timeline li::before{top:0;left:0}.story-timeline-date{font-size:.76rem}}
</style>

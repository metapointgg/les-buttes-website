---
import{getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import ResponsiveImage from'../../components/ResponsiveImage.astro';import Callout from'../../components/Callout.astro';const page=await getEntry('pages','about');if(!page)throw new Error('Missing');const{Content}=await render(page);
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><div class="wrap"><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}/></div><section class="section-tight paper"><div class="wrap intro-split"><div class:list={['cottage-hero-image',page.data.heroPan&&'image-pan']}><ResponsiveImage src={page.data.heroImage ?? '/src/assets/images/cottages/geranium/exterior.jpg'} alt={page.data.heroAlt ?? 'Traditional granite exterior of Geranium Cottage'}/></div><div><p class="eyebrow">Our story</p><h2>A farmstead made for welcoming guests</h2><div class="prose"><Content/></div></div></div></section><section class="section wrap"><div class="info-grid"><article class="info-card"><span class="number">16th century</span><h2>Historic surroundings</h2><p>The cottages sit within the buildings of a restored traditional Guernsey farm.</p></article><article class="info-card"><span class="number">Since 1981</span><h2>A family enterprise</h2><p>The Ozanne family has welcomed self-catering guests for more than four decades.</p></article><article class="info-card"><span class="number">Today</span><h2>A simple promise</h2><p>Comfortable cottages, practical help and freedom to discover Guernsey in your own time.</p></article></div></section><Callout title="Come and make your own Les Buttes memories" text="Choose the cottage that suits your party, then check live dates and prices through Airbnb." href="/cottages/" label="Meet the cottages"/></BaseLayout>

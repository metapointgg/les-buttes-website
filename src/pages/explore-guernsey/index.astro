---
import{getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import ResponsiveImage from'../../components/ResponsiveImage.astro';import Callout from'../../components/Callout.astro';const page=await getEntry('pages','things-to-do');if(!page)throw new Error('Missing');const{Content}=await render(page);const exp=[['West-coast beaches','Spend a day on broad sandy beaches such as Vazon, Cobo and L’Eree.','https://www.visitguernsey.com/experiences/beaches/'],['South-coast walks','Follow dramatic cliff paths through wild headlands, hidden coves and sea views.','https://www.visitguernsey.com/experiences/walking/'],['St Peter Port','Explore independent shops, harbourside restaurants, Castle Cornet and old-town lanes.','https://www.visitguernsey.com/experiences/culture-heritage/'],['Island history','Discover prehistoric sites, fortifications and museums telling Guernsey’s story.','https://www.visitguernsey.com/experiences/culture-heritage/'],['Neighbouring islands','Take a day trip to Herm, Sark or Alderney for another perspective on the Bailiwick.','https://www.visitguernsey.com/islands/'],['Local food','Try seafood, island produce and rich dairy made from Guernsey cows.','https://www.visitguernsey.com/experiences/food-drink/']];
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><div class="wrap"><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}/></div><section class="section-tight paper"><div class="wrap intro-split"><div class="cottage-hero-image"><ResponsiveImage src="/src/assets/images/cottages/honeysuckle/garden.jpg" alt="A peaceful garden at Les Buttes"/></div><div><p class="eyebrow">Island experiences</p><h2>A little island with a lot to discover</h2><div class="prose"><Content/></div></div></div></section><section class="section wrap"><header class="section-heading"><p class="eyebrow">Make a day of it</p><h2>Ideas for your stay</h2><p class="lede">Opening times and transport can change, so check the linked visitor information before setting out.</p></header><div class="experience-grid">{exp.map((i,n)=><article class="experience-card"><span class="number">0{n+1}</span><h2>{i[0]}</h2><p>{i[1]}</p><a href={i[2]} target="_blank" rel="noopener">Plan your visit ↗</a></article>)}</div></section><Callout title="A peaceful base for your island days" text="Return from the coast, town or neighbouring islands to your own cottage and garden at Les Buttes." href="/cottages/" label="Explore our cottages"/></BaseLayout>

---
import{getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import ResponsiveImage from'../../components/ResponsiveImage.astro';import Callout from'../../components/Callout.astro';import Icon from'../../components/Icon.astro';const page=await getEntry('pages','things-to-do');if(!page)throw new Error('Missing');const{Content}=await render(page);const exp=[['West-coast beaches','Spend a day on broad sandy beaches such as Vazon, Cobo and L’Eree.','https://www.visitguernsey.com/experiences/beaches/','Explore Guernsey’s beaches','beach'],['South-coast walks','Follow dramatic cliff paths through wild headlands, hidden coves and sea views.','https://www.visitguernsey.com/experiences/walking/','Plan a walk','walk'],['St Peter Port','Explore independent shops, harbourside restaurants, Castle Cornet and old-town lanes.','https://www.visitguernsey.com/experiences/culture-heritage/','Explore St Peter Port','guernsey'],['Island history','Discover prehistoric sites, fortifications and museums telling Guernsey’s story.','https://www.visitguernsey.com/experiences/culture-heritage/','Discover Guernsey’s history','history'],['Neighbouring islands','Take a day trip to Herm, Sark or Alderney for another perspective on the Bailiwick.','https://www.visitguernsey.com/islands/','Explore the islands','islands'],['Local food','Try seafood, island produce and rich dairy made from Guernsey cows.','https://www.visitguernsey.com/experiences/food-drink/','Find places to eat','food']] as const;
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro} mediaType={page.data.heroMediaType} imageSrc={page.data.heroImage} imageAlt={page.data.heroAlt} pan={page.data.heroPan} videoSrc={page.data.heroVideo} posterSrc={page.data.heroPoster}/><section class="section-tight paper"><div class="wrap intro-split"><div class:list={['cottage-hero-image',page.data.experienceImagePan&&'image-pan']}><ResponsiveImage src={page.data.experienceImage ?? '/src/assets/images/cottages/honeysuckle/garden.jpg'} alt={page.data.experienceImageAlt ?? 'A peaceful garden at Les Buttes'}/></div><div><p class="eyebrow">Island experiences</p><h2>A little island with a lot to discover</h2><div class="prose"><Content/></div></div></div></section><section class="section wrap"><header class="section-heading"><p class="eyebrow">Make a day of it</p><h2>Ideas for your stay</h2><p class="lede">Opening times and transport can change, so check the linked visitor information before setting out.</p></header><div class="experience-grid">{exp.map((i,n)=><article class="experience-card"><span class="number">0{n+1}</span><h2>{i[0]}</h2><p>{i[1]}</p><a class="experience-link-button" href={i[2]} target="_blank" rel="noopener"><span>{i[3]}</span><span class="experience-link-icon"><Icon name={i[4]} size={20}/></span></a></article>)}</div></section><Callout title="A peaceful base for your island days" text="Return from the coast, town or neighbouring islands to your own cottage and garden at Les Buttes." href="/cottages/" label="Explore our cottages"/></BaseLayout>

<style>
  .experience-card{display:flex;flex-direction:column}
  .experience-card>p{flex:1}
  .experience-link-button{display:inline-flex;align-items:center;justify-content:space-between;gap:.8rem;width:max-content;max-width:100%;margin-top:.75rem;padding:.55rem .55rem .55rem 1rem;color:var(--green);background:var(--cream);border:1px solid #194c3d33;border-radius:999px;font-size:.92rem;font-weight:700;line-height:1.25;text-decoration:none;transition:background .2s,border-color .2s,transform .2s}
  .experience-link-button:hover{background:var(--pale);border-color:#194c3d66;transform:translateY(-1px)}
  .experience-link-button:focus-visible{outline:3px solid #d79a43;outline-offset:3px}
  .experience-link-icon{display:grid;flex:0 0 2.1rem;width:2.1rem;height:2.1rem;place-items:center;color:#fff;background:var(--green);border-radius:50%}
  @media(max-width:27rem){.experience-link-button{width:100%}}
</style>

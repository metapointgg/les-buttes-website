---
import{getCollection,getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import CottageCard from'../../components/CottageCard.astro';import Callout from'../../components/Callout.astro';const page=await getEntry('pages','our-cottages');if(!page)throw new Error('Missing content');const{Content}=await render(page);const cottages=(await getCollection('cottages')).filter(c=>c.data.available).sort((a,b)=>a.data.name.localeCompare(b.data.name));
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><div class="wrap"><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}/></div><section class="section-tight paper"><div class="wrap"><div class="prose section-heading"><Content/></div><div class="cottage-grid">{cottages.map(c=><CottageCard cottage={c}/>)}</div></div></section><section class="section wrap"><div class="info-grid"><article class="info-card"><h2>Simple, secure booking</h2><p>Live availability, current prices and reservations are handled through Airbnb.</p></article><article class="info-card"><h2>Everything included</h2><p>Heating, electricity, Wi-Fi, linen and towels are included in your stay.</p></article><article class="info-card"><h2>Where are we?</h2><p>Les Buttes is in peaceful St Pierre du Bois, close to village amenities, beaches and the south-coast cliffs.</p><a href="/find-us/#map">View map</a></article></div></section><Callout title="Questions before you choose?" text="Tell us who is travelling and what matters most to you. We’ll be happy to help." href="/contact/" label="Contact Les Buttes"/></BaseLayout>

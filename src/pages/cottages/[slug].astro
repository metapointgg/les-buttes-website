---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroMedia from '../../components/HeroMedia.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import ReviewsCarousel from '../../components/ReviewsCarousel.astro';
import Callout from '../../components/Callout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import { getImage as getImageMetadata } from '../../lib/images';

export async function getStaticPaths(){
  return (await getCollection('cottages')).filter(c=>c.data.available).map(c=>({params:{slug:c.data.slug}}));
}

const cottage=await getEntry('cottages',Astro.params.slug!);
if(!cottage||!cottage.data.available) throw new Error('Cottage not found');
const c=cottage.data;
const details=c.details;
const contentSections=c.sections??[];
const galleryIndexForImage=(image:string)=>c.gallery.findIndex(item=>item.image===image);
const cottageReviews=c.reviews?.length
  ? c.reviews
  : c.review
    ? [{stars:5,comment:c.review.quote,userDetails:c.review.guest,sourceUrl:c.review.sourceUrl,sourceLabel:'Read reviews on Airbnb'}]
    : [];

const findFacility=(pattern:RegExp)=>c.facilities.find(item=>pattern.test(item));
type FacilityIcon='wifi'|'kitchen'|'bed'|'pin'|'garden';
const facilityOverview=([
  {icon:'wifi',title:'Wi-Fi',text:findFacility(/wi-fi/i)},
  {icon:'kitchen',title:'Kitchen',text:findFacility(/fully equipped kitchen/i)},
  {icon:'kitchen',title:'Washing facilities',text:findFacility(/washing|dryer/i)},
  {icon:'bed',title:'Heating, linen & towels',text:findFacility(/heating.*linen.*towels/i)},
  {icon:'pin',title:'Parking',text:findFacility(/parking/i)},
  {icon:'garden',title:'Private garden',text:findFacility(/private.*garden/i)}
] as Array<{icon:FacilityIcon;title:string;text:string|undefined}>).filter(item=>Boolean(item.text));

const privateGarden=findFacility(/private.*garden/i);
const parking=findFacility(/parking/i);
const floorLayoutAnswer=details?.floorLayout?.map(level=>`${level.floor}: ${level.rooms.join(', ')}.`).join(' ');
const faqItems=[
  {
    question:`How many guests can ${c.name} accommodate?`,
    answer:`${c.name} sleeps up to ${c.sleeps} guests in ${c.bedrooms} bedrooms.`
  },
  ...(details?[{
    question:`What is the bedroom and room layout at ${c.name}?`,
    answer:`${c.name} has ${details.bedroomLayout.toLowerCase()}. ${floorLayoutAnswer??''}`.trim()
  }]:[]),
  {
    question:`How many bathrooms does ${c.name} have?`,
    answer:details?.bathroomLayout
      ? `${c.name} has ${c.bathrooms} bathrooms: ${details.bathroomLayout.toLowerCase()}.`
      : `${c.name} has ${c.bathrooms} bathrooms.`
  },
  ...(details?[{
    question:`Where is ${c.name} in Guernsey?`,
    answer:`${c.name} is at Les Buttes Holiday Cottages, ${details.location}`
  }]:[]),
  ...(details?.familyEquipment?.length?[{
    question:`What family equipment is available at ${c.name}?`,
    answer:`${details.familyEquipment.join(', ')}.`
  }]:[]),
  ...(privateGarden?[{
    question:`Does ${c.name} have a private garden?`,
    answer:details?.outdoorSpace
      ? `Yes. ${c.name} has ${details.outdoorSpace.toLowerCase()}.`
      : `Yes. ${c.name} has its own ${privateGarden.toLowerCase()}.`
  }]:[]),
  ...(parking?[{
    question:`Is parking available at ${c.name}?`,
    answer:`Yes. ${details?.parking??parking}.`
  }]:[]),
  {
    question:`Is ${c.name} dog friendly?`,
    answer:c.dogFriendly
      ? `Yes. ${c.name} is dog friendly.`
      : `${c.name} is not listed as dog friendly. Geranium Cottage is the dog-friendly cottage at Les Buttes.`
  }
];

const propertyUrl=new URL(`/cottages/${c.slug}/`,site.url).toString();
const imageUrls=c.gallery.map(item=>new URL(getImageMetadata(item.image).src,site.url).toString());
const facilitiesText=c.facilities.join(' ');
const familyEquipmentText=(details?.familyEquipment??[]).join(' ');
const bedDetails=(details?.bedTypes??[]).map(item=>({
  '@type':'BedDetails',
  numberOfBeds:item.count,
  typeOfBed:item.type
}));
const amenityFeature=[
  {'@type':'LocationFeatureSpecification',name:'wifi',value:/wi-fi/i.test(facilitiesText)},
  ...(/free wi-fi/i.test(facilitiesText)?[{'@type':'LocationFeatureSpecification',name:'internetType',value:'Free'}]:[]),
  {'@type':'LocationFeatureSpecification',name:'kitchen',value:/fully equipped kitchen/i.test(facilitiesText)},
  {'@type':'LocationFeatureSpecification',name:'heating',value:/heating/i.test(facilitiesText)},
  {'@type':'LocationFeatureSpecification',name:'tv',value:/television/i.test(facilitiesText)},
  {'@type':'LocationFeatureSpecification',name:'washerDryer',value:/washing machine|dryer/i.test(facilitiesText)},
  ...(/travel cot|crib/i.test(familyEquipmentText)?[{'@type':'LocationFeatureSpecification',name:'crib',value:true}]:[]),
  ...(details?.familyEquipment?.length?[{'@type':'LocationFeatureSpecification',name:'childFriendly',value:true}]:[]),
  {'@type':'LocationFeatureSpecification',name:'petsAllowed',value:c.dogFriendly}
];
const vacationRentalJsonLd={
  '@context':'https://schema.org',
  '@type':'VacationRental',
  '@id':`${propertyUrl}#vacation-rental`,
  identifier:`les-buttes-${c.slug}`,
  additionalType:'Cottage',
  name:c.name,
  description:c.summary,
  url:propertyUrl,
  image:imageUrls,
  latitude:site.coordinates.latitude,
  longitude:site.coordinates.longitude,
  address:{
    '@type':'PostalAddress',
    streetAddress:site.address.street,
    addressLocality:site.address.locality,
    addressRegion:site.address.island,
    postalCode:site.address.postcode,
    addressCountry:site.address.country
  },
  brand:{'@type':'Brand',name:site.name},
  provider:{'@id':`${site.url}/#business`},
  sameAs:c.airbnbUrl,
  containsPlace:{
    '@type':'Accommodation',
    additionalType:'EntirePlace',
    occupancy:{'@type':'QuantitativeValue',value:c.sleeps},
    ...(bedDetails.length?{bed:bedDetails}:{}),
    numberOfBedrooms:c.bedrooms,
    numberOfBathroomsTotal:c.bathrooms,
    petsAllowed:c.dogFriendly,
    amenityFeature
  }
};
const faqJsonLd={
  '@context':'https://schema.org',
  '@type':'FAQPage',
  mainEntity:faqItems.map(item=>({
    '@type':'Question',
    name:item.question,
    acceptedAnswer:{'@type':'Answer',text:item.answer}
  }))
};
---
<BaseLayout title={c.seo.title} description={c.seo.description} jsonLd={[vacationRentalJsonLd,faqJsonLd]}>
  <article class="cottage-focused-page">
    <header class="cottage-editorial-hero">
      <HeroMedia mediaType={c.heroMediaType} imageSrc={c.heroImage} imageAlt={c.heroAlt} pan={c.heroPan} videoSrc={c.heroVideo} posterSrc={c.heroPoster} class="cottage-editorial-hero-media" widths={[640,960,1280,1600,1920]} sizes="100vw" loading="eager" fetchpriority="high" decorative />
      <div class="wrap cottage-editorial-hero-inner">
        <div class="cottage-editorial-copy">
          <h1>{c.name}</h1>
          <p class="cottage-hero-summary">{c.tagline}</p>
          <ul class="cottage-hero-facts" aria-label="Accommodation summary">
            <li><Icon name="guests" size={18}/>Sleeps {c.sleeps}</li>
            <li><Icon name="bed" size={18}/>{c.bedrooms} bedrooms</li>
            <li><Icon name="bath" size={18}/>{c.bathrooms} bathrooms</li>
            {c.season&&<li>Season {c.season}</li>}
            {c.dogFriendly&&<li class="cottage-dog-fact">● Dog friendly</li>}
          </ul>
          <div class="cottage-actions">
            {c.airbnbUrl&&<a class="button button-light" href={c.airbnbUrl} target="_blank" rel="noopener">Check availability <Icon name="external" size={17}/></a>}
            <button class="button button-outline" type="button" data-open-cottage-gallery>View gallery</button>
          </div>
        </div>
      </div>
    </header>

    {details && (
      <section class="section-tight cottage-details-section paper" aria-labelledby={`cottage-details-${c.slug}`}>
        <div class="wrap">
          <header class="section-heading cottage-details-heading">
            <p class="eyebrow">At a glance</p>
            <h2 id={`cottage-details-${c.slug}`}>{c.name} details</h2>
          </header>

          <dl class="cottage-details-grid">
            <div><dt>Location</dt><dd>{details.location}</dd></div>
            <div><dt>Sleeps</dt><dd>{c.sleeps} guests</dd></div>
            <div><dt>Bedrooms</dt><dd>{c.bedrooms} · {details.bedroomLayout}</dd></div>
            <div><dt>Bathrooms</dt><dd>{c.bathrooms} · {details.bathroomLayout}</dd></div>
            <div><dt>Parking</dt><dd>{details.parking}</dd></div>
            <div><dt>Outdoor space</dt><dd>{details.outdoorSpace}</dd></div>
          </dl>

          <div class="cottage-details-support">
            {details.floorLayout?.length ? <article>
              <h3>Layout</h3>
              <div class="cottage-floor-layout">
                {details.floorLayout.map(level=><div>
                  <strong>{level.floor}</strong>
                  <span>{level.rooms.join(' · ')}</span>
                </div>)}
              </div>
            </article> : null}
            <article>
              <h3>Living space</h3>
              <p>{details.livingSpace}</p>
            </article>
            {details.familyEquipment?.length ? <article>
              <h3>Family equipment</h3>
              <ul>{details.familyEquipment.map(item=><li>{item}</li>)}</ul>
            </article> : null}
            {details.nearby?.length ? <article>
              <h3>Nearby</h3>
              <ul>{details.nearby.map(item=><li>{item}</li>)}</ul>
            </article> : null}
          </div>
        </div>
      </section>
    )}

    <div class="cottage-content-sections">
      {contentSections.map((section,index)=>{
        const images=section.images.slice(0,4);
        return <section class:list={['section','cottage-template-section',index%2===0&&'paper']}>
          <div class="wrap cottage-template-grid">
            <div class="cottage-template-copy">
              <h2>{section.title}</h2>
              <p>{section.description}</p>
            </div>
            <div class:list={['cottage-template-images',`count-${images.length}`]}>
              {images.map((item,imageIndex)=>{
                const galleryIndex=galleryIndexForImage(item.image);
                const imageLabel=item.caption??item.alt??section.title;
                return <figure class:list={[imageIndex===0&&'is-primary']}>
                  <button
                    class="cottage-template-image-button"
                    type="button"
                    data-open-cottage-gallery
                    data-gallery-index={galleryIndex>=0?galleryIndex:0}
                    aria-label={`Open ${imageLabel} in the ${c.name} gallery`}
                  >
                    <ResponsiveImage src={item.image} alt={item.alt??section.title} widths={[420,640,900,1200]} sizes="(max-width: 768px) 100vw, 52vw"/>
                  </button>
                  {item.caption&&images.length>1&&<figcaption>{item.caption}</figcaption>}
                </figure>;
              })}
            </div>
          </div>
        </section>;
      })}
    </div>

    <section class="section cottage-facilities-section cottage-facilities-compact">
      <div class="wrap">
        <header class="section-heading cottage-facilities-heading">
          <h2>Everything you need</h2>
        </header>
        <ul class="cottage-facility-grid">
          {facilityOverview.map(item=><li>
            <span class="cottage-facility-icon"><Icon name={item.icon} size={38}/></span>
            <div class="cottage-facility-copy"><h3>{item.title}</h3><p>{item.text}</p></div>
          </li>)}
        </ul>
      </div>
    </section>

    <section class="section paper cottage-faq-section" aria-labelledby={`faq-${c.slug}`}>
      <div class="wrap cottage-faq-wrap">
        <header class="section-heading cottage-faq-heading">
          <p class="eyebrow">Frequently asked questions</p>
          <h2 id={`faq-${c.slug}`}>Planning your stay at {c.name}</h2>
        </header>
        <div class="cottage-faq-list">
          {faqItems.map(item=><details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>)}
        </div>
      </div>
    </section>

    <ReviewsCarousel
      reviews={cottageReviews}
      title="Guest reviews"
      autoRotate={c.reviewAutoRotate ?? false}
      rotateIntervalSeconds={c.reviewIntervalSeconds ?? 6.5}
    />

    <Callout title={`Check availability for ${c.name}`} text="View current dates, prices and booking terms securely through Airbnb." href={c.airbnbUrl??'/contact/'} label={c.airbnbUrl?'Check availability':'Contact us'}/>
  </article>

  <dialog id={`cottage-gallery-${c.slug}`} class="cottage-quick-gallery" data-cottage-gallery-dialog>
    <button class="cottage-quick-gallery-close" type="button" data-gallery-close aria-label="Close gallery">×</button>
    <div class="cottage-quick-gallery-header">
      <h2>{c.name} gallery</h2>
      <span class="cottage-quick-gallery-counter" data-gallery-counter aria-live="polite"></span>
    </div>
    <div class="cottage-quick-gallery-stage" id="gallery">
      <button class="cottage-quick-gallery-nav cottage-quick-gallery-prev" type="button" data-gallery-prev aria-label="Previous photograph">‹</button>
      <div class="cottage-quick-gallery-slides">
        {c.gallery.map((item,index)=><figure data-gallery-slide data-gallery-index={index} hidden={index!==0}>
          <ResponsiveImage src={item.image} alt={item.alt} widths={[960,1280,1600,2000]} sizes="100vw"/>
          <figcaption>{item.caption}</figcaption>
        </figure>)}
      </div>
      <button class="cottage-quick-gallery-nav cottage-quick-gallery-next" type="button" data-gallery-next aria-label="Next photograph">›</button>
    </div>
    <div class="cottage-quick-gallery-thumbs" aria-label="Choose a photograph">
      {c.gallery.map((item,index)=><button type="button" data-gallery-thumb data-gallery-index={index} aria-label={`View ${item.caption}`}>
        <ResponsiveImage src={item.image} alt="" widths={[120,180,240]} sizes="7rem"/>
      </button>)}
    </div>
  </dialog>
</BaseLayout>

<script is:inline>
(() => {
  const dialog=document.querySelector('[data-cottage-gallery-dialog]');
  if(!(dialog instanceof HTMLDialogElement)) return;

  const slides=Array.from(dialog.querySelectorAll('[data-gallery-slide]'));
  const thumbs=Array.from(dialog.querySelectorAll('[data-gallery-thumb]'));
  const counter=dialog.querySelector('[data-gallery-counter]');
  let activeIndex=0;

  const showSlide=index=>{
    if(!slides.length) return;
    activeIndex=(index+slides.length)%slides.length;
    slides.forEach((slide,slideIndex)=>{
      if(!(slide instanceof HTMLElement)) return;
      slide.hidden=slideIndex!==activeIndex;
    });
    thumbs.forEach((thumb,thumbIndex)=>{
      if(!(thumb instanceof HTMLElement)) return;
      thumb.toggleAttribute('aria-current',thumbIndex===activeIndex);
    });
    if(counter) counter.textContent=`${activeIndex+1} / ${slides.length}`;
  };

  const openGallery=index=>{
    showSlide(Number.isFinite(index)?index:0);
    if(!dialog.open) dialog.showModal();
  };

  document.querySelectorAll('[data-open-cottage-gallery]').forEach(trigger=>{
    trigger.addEventListener('click',()=>{
      const index=Number.parseInt(trigger.getAttribute('data-gallery-index')??'0',10);
      openGallery(Number.isNaN(index)?0:index);
    });
  });

  dialog.querySelector('[data-gallery-prev]')?.addEventListener('click',()=>showSlide(activeIndex-1));
  dialog.querySelector('[data-gallery-next]')?.addEventListener('click',()=>showSlide(activeIndex+1));
  dialog.querySelector('[data-gallery-close]')?.addEventListener('click',()=>dialog.close());

  thumbs.forEach(thumb=>{
    thumb.addEventListener('click',()=>{
      const index=Number.parseInt(thumb.getAttribute('data-gallery-index')??'0',10);
      showSlide(Number.isNaN(index)?0:index);
    });
  });

  dialog.addEventListener('click',event=>{if(event.target===dialog) dialog.close();});
  dialog.addEventListener('keydown',event=>{
    if(event.key==='ArrowLeft'){event.preventDefault();showSlide(activeIndex-1);}
    if(event.key==='ArrowRight'){event.preventDefault();showSlide(activeIndex+1);}
  });
  dialog.addEventListener('close',()=>{
    const url=new URL(window.location.href);
    if(url.searchParams.has('gallery')){
      url.searchParams.delete('gallery');
      history.replaceState(null,'',url.pathname+url.search+url.hash.replace('#gallery',''));
    }
  });

  const requestedIndex=Number.parseInt(new URLSearchParams(window.location.search).get('gallery')??'',10);
  if(!Number.isNaN(requestedIndex)) openGallery(requestedIndex);
})();
</script>

<style is:global>
.cottage-focused-page .cottage-editorial-hero{min-height:clamp(34rem,58vw,44rem)}
.cottage-focused-page .cottage-editorial-copy{max-width:40rem}
.cottage-focused-page .cottage-editorial-copy .cottage-hero-summary{max-width:31rem;margin-bottom:1rem}
.cottage-hero-facts{display:flex;flex-wrap:wrap;gap:.65rem 1.15rem;margin:1rem 0 0;padding:1rem 0;border-block:1px solid rgba(255,255,255,.28);list-style:none}
.cottage-hero-facts li{display:flex;align-items:center;gap:.4rem;color:#fff;font-size:.9rem;font-weight:600}
.cottage-dog-fact{font-size:.82rem!important}
.cottage-focused-page .cottage-actions{margin-top:1.25rem!important}
.cottage-focused-page .cottage-actions button.button{font:700 .9rem var(--body);cursor:pointer}

.cottage-details-section{padding-block:clamp(2.4rem,4vw,3.5rem)!important;border-bottom:1px solid var(--line)}
.cottage-details-heading{margin-bottom:1.4rem!important}
.cottage-details-heading h2{font-size:clamp(2rem,3vw,2.7rem)}
.cottage-details-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:0;border:1px solid var(--line);border-radius:.75rem;background:var(--cream);overflow:hidden}
.cottage-details-grid>div{min-width:0;padding:1.05rem 1.2rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.cottage-details-grid>div:nth-child(3n){border-right:0}
.cottage-details-grid>div:nth-last-child(-n+3){border-bottom:0}
.cottage-details-grid dt{margin:0 0 .28rem;color:var(--green);font-size:.76rem;font-weight:750;letter-spacing:.055em;text-transform:uppercase}
.cottage-details-grid dd{margin:0;color:var(--ink);font-size:.93rem;line-height:1.5}
.cottage-details-support{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}
.cottage-details-support article{padding:1.25rem 1.35rem;background:var(--paper);border:1px solid var(--line);border-radius:.75rem}
.cottage-details-support h3{margin:0 0 .7rem;font:700 1rem var(--body);letter-spacing:0}
.cottage-details-support p,.cottage-details-support li,.cottage-floor-layout span{color:var(--soft);font-size:.9rem;line-height:1.55}
.cottage-details-support p{margin:0}
.cottage-details-support ul{display:grid;gap:.35rem;margin:0;padding-left:1.1rem}
.cottage-floor-layout{display:grid;gap:.65rem}
.cottage-floor-layout>div{display:grid;gap:.18rem}
.cottage-floor-layout strong{color:var(--ink);font-size:.87rem}

.cottage-template-section{padding-block:clamp(2.8rem,5vw,4.5rem)!important}
.cottage-template-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(2rem,5vw,5.2rem);align-items:center;min-width:0}
.cottage-template-copy{max-width:34rem;min-width:0}
.cottage-template-copy h2{max-width:15ch;margin-bottom:1.15rem}
.cottage-template-copy p{margin:0;color:var(--soft);font-size:1.04rem;line-height:1.68}
.cottage-template-images{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem;min-width:0}
.cottage-template-images figure{position:relative;overflow:hidden;margin:0;min-width:0;aspect-ratio:4/3;background:var(--pale);border-radius:.35rem}
.cottage-template-image-button{display:block;width:100%;height:100%;padding:0;border:0;background:transparent;cursor:zoom-in}
.cottage-template-image-button:focus-visible{outline:3px solid var(--gold);outline-offset:-3px}
.cottage-template-images picture,.cottage-template-images img{display:block;width:100%;height:100%}
.cottage-template-images img{object-fit:cover;transition:transform .2s ease}
.cottage-template-image-button:hover img{transform:scale(1.015)}
.cottage-template-images.count-1{grid-template-columns:minmax(0,1fr)}
.cottage-template-images.count-1 figure{aspect-ratio:16/10}
.cottage-template-images.count-2 figure{aspect-ratio:4/3}
.cottage-template-images.count-3 figure.is-primary{grid-column:1/-1;aspect-ratio:16/8}
.cottage-template-images.count-4 figure{aspect-ratio:4/3}
.cottage-template-images figcaption{position:absolute;right:.45rem;bottom:.45rem;left:.45rem;padding:.36rem .5rem;color:#fff;background:linear-gradient(90deg,rgba(6,29,24,.7),rgba(6,29,24,.08));border-radius:.2rem;font-size:.7rem}

.cottage-facilities-compact{padding-block:clamp(2.7rem,4vw,3.7rem)!important}
.cottage-facilities-compact .cottage-facilities-heading{margin-bottom:1.2rem!important}
.cottage-facilities-compact .cottage-facilities-heading h2{font-size:clamp(2rem,3.2vw,2.8rem)}
.cottage-facilities-compact .cottage-facility-grid{gap:0!important}
.cottage-facilities-compact .cottage-facility-grid li{min-height:0!important;padding:1rem 1.2rem!important}
.cottage-facilities-compact .cottage-facility-icon{width:2.75rem;height:2.75rem}
.cottage-facilities-compact .cottage-facility-icon svg{width:2.35rem!important;height:2.35rem!important;stroke-width:1.7}
.cottage-facilities-compact .cottage-facility-copy h3{font-size:1.05rem!important}
.cottage-facilities-compact .cottage-facility-copy p{font-size:.82rem}

.cottage-faq-wrap{max-width:62rem}
.cottage-faq-heading{margin-bottom:1.5rem!important}
.cottage-faq-heading h2{max-width:20ch}
.cottage-faq-list{border-top:1px solid rgba(31,59,46,.16)}
.cottage-faq-list details{border-bottom:1px solid rgba(31,59,46,.16)}
.cottage-faq-list summary{position:relative;padding:1.15rem 2.4rem 1.15rem 0;color:var(--deep);font-weight:700;cursor:pointer;list-style:none}
.cottage-faq-list summary::-webkit-details-marker{display:none}
.cottage-faq-list summary::after{content:'+';position:absolute;right:.25rem;top:50%;transform:translateY(-50%);font-size:1.35rem;font-weight:400}
.cottage-faq-list details[open] summary::after{content:'–'}
.cottage-faq-list p{max-width:48rem;margin:0;padding:0 2.4rem 1.2rem 0;color:var(--soft);line-height:1.65}

.cottage-focused-page>.callout{margin-top:2.2rem!important;margin-bottom:clamp(2.5rem,5vw,4rem)!important;padding-block:clamp(3rem,5vw,4.5rem)!important}
.cottage-focused-page>.callout h2{max-width:20ch}

.cottage-quick-gallery{width:100vw!important;max-width:none!important;height:100dvh;max-height:none!important;margin:0;padding:0;border:0;background:#07110d;box-shadow:none}
.cottage-quick-gallery::backdrop{background:#07110df5}

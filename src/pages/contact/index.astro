---
import{getEntry,render}from'astro:content';import BaseLayout from'../../layouts/BaseLayout.astro';import PageIntro from'../../components/PageIntro.astro';import Icon from'../../components/Icon.astro';import site from'../../data/site.json';const page=await getEntry('pages','contact');if(!page)throw new Error('Missing');const{Content}=await render(page);
---
<BaseLayout title={page.data.seo.title} description={page.data.seo.description}><div class="wrap"><PageIntro eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.intro}/></div><section class="section-tight paper"><div class="wrap intro-split"><div><p class="eyebrow">Get in touch</p><h2>Speak to the family at Les Buttes</h2><div class="prose"><Content/></div></div><div class="contact-grid"><a class="contact-card" href={`mailto:${site.email}`}><Icon name="mail" size={26}/><span><strong>Email us</strong><span>{site.email}</span></span></a><a class="contact-card" href={`tel:${site.telephoneHref}`}><Icon name="phone" size={26}/><span><strong>Call us</strong><span>{site.telephoneDisplay}</span></span></a><a class="contact-card" href="/find-us/"><Icon name="pin" size={26}/><span><strong>Find Les Buttes</strong><span>St Pierre du Bois, Guernsey</span></span></a><a class="contact-card" href="/cottages/"><Icon name="external" size={26}/><span><strong>Book a cottage</strong><span>Check availability through Airbnb</span></span></a></div></div></section><section class="section wrap"><div class="notice"><strong>Please note:</strong> Reservations and payments are only made through Airbnb. Les Buttes will never ask you to send a booking payment by email or bank transfer.</div></section></BaseLayout>

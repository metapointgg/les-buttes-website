---
import { getCollection } from 'astro:content';
import { getImage as optimiseImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import DesignTokens from '../components/DesignTokens.astro';
import { getImage } from '../lib/images';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/refinement.css';
import '../styles/secondary-pages.css';
import '../styles/redline-polish.css';
import '../styles/redline-polish-fixes.css';
import '../styles/cottage-mobile.css';
import site from '../data/site.json';

interface Props {
  title:string;
  description:string;
  canonical?:string;
  jsonLd?:Record<string,unknown>|Record<string,unknown>[];
  noindex?:boolean;
}

const {
  title,
  description,
  canonical=new URL(Astro.url.pathname,site.url).toString(),
  jsonLd,
  noindex=false
}=Astro.props;

const pathKey=Astro.url.pathname==='/'?'home':Astro.url.pathname.replace(/^\/+|\/+$/g,'').replace(/\//g,'-')||'home';
const pageClass=`page-${pathKey}`;

const [pages,subpages,cottages]=await Promise.all([
  getCollection('pages'),
  getCollection('subpages'),
  getCollection('cottages')
]);

const currentPath=Astro.url.pathname;
const pageEntry=pages.find(entry=>entry.data.urlStub===currentPath);
const subpageEntry=subpages.find(entry=>`/${entry.data.slug}/`===currentPath);
const cottageSlug=currentPath.match(/^\/cottages\/([^/]+)\/$/)?.[1];
const cottageEntry=cottageSlug?cottages.find(entry=>entry.data.slug===cottageSlug):undefined;
const currentEntry=pageEntry??subpageEntry??cottageEntry;

const socialBaseUrl=new URL(site.url);
socialBaseUrl.hostname=`www.${socialBaseUrl.hostname.replace(/^www\./,'')}`;
const socialUrl=new URL(currentPath,socialBaseUrl).toString();
const defaultSocialImage=new URL('/social/les-buttes-social.jpg',socialBaseUrl).toString();
const socialImageSource=currentEntry?.data.seo.image;

const socialImage=socialImageSource?.startsWith('/src/assets/images/')
  ? new URL((await optimiseImage({
      src:getImage(socialImageSource),
      width:1200,
      height:630,
      fit:'cover',
      position:'center',
      format:'jpg',
      quality:86
    })).src,socialBaseUrl).toString()
  : socialImageSource
    ? new URL(socialImageSource,socialBaseUrl).toString()
    : defaultSocialImage;

const socialTitle=currentEntry?.data.seo.socialTitle??title;
const socialDescription=currentEntry?.data.seo.socialDescription??description;
const socialImageAlt=currentEntry?.data.seo.imageAlt??'Les Buttes Holiday Cottages in Guernsey';
const businessImage=defaultSocialImage;

const businessId=`${site.url}/#business`;
const localBusiness={
  '@context':'https://schema.org',
  '@type':'LodgingBusiness',
  '@id':businessId,
  name:site.name,
  url:site.url,
  description:'Family-run self-catering holiday cottages in peaceful St Pierre du Bois, Guernsey.',
  email:site.email,
  telephone:site.telephoneHref,
  image:businessImage,
  sameAs:site.sameAs,
  address:{
    '@type':'PostalAddress',
    streetAddress:site.address.street,
    addressLocality:site.address.locality,
    addressRegion:site.address.island,
    postalCode:site.address.postcode,
    addressCountry:site.address.country
  },
  geo:{'@type':'GeoCoordinates',latitude:site.coordinates.latitude,longitude:site.coordinates.longitude}
};

const webPage={
  '@context':'https://schema.org',
  '@type':'WebPage',
  '@id':`${canonical}#webpage`,
  url:canonical,
  name:title,
  description,
  primaryImageOfPage:{'@type':'ImageObject',url:socialImage,contentUrl:socialImage}
};

const pageJsonLd=jsonLd?(Array.isArray(jsonLd)?jsonLd:[jsonLd]):[];
const structuredData=[localBusiness,webPage,...pageJsonLd];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="theme-color" content="#194c3d"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    <meta name="robots" content={noindex?'noindex,follow,max-image-preview:large':'max-image-preview:large'}/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={site.name}/>
    <meta property="og:locale" content="en_GB"/>
    <meta property="og:title" content={socialTitle}/>
    <meta property="og:description" content={socialDescription}/>
    <meta property="og:url" content={socialUrl}/>
    <meta property="og:image" content={socialImage}/>
    <meta property="og:image:secure_url" content={socialImage}/>
    <meta property="og:image:type" content="image/jpeg"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content={socialImageAlt}/>

    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={socialTitle}/>
    <meta name="twitter:description" content={socialDescription}/>
    <meta name="twitter:image" content={socialImage}/>
    <meta name="twitter:image:alt" content={socialImageAlt}/>

    <link rel="icon" href="/favicon.png" type="image/png"/>
    <link rel="apple-touch-icon" href="/favicon.png"/>
    <DesignTokens/>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header/>
    <main id="main-content"><slot/></main>
    <Footer/>
    <NewsletterSignup/>
  </body>
</html>

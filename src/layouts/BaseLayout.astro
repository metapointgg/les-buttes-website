---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import '../styles/global.css'; import site from '../data/site.json';
interface Props { title:string; description:string; canonical?:string; jsonLd?:Record<string,unknown>; noindex?:boolean }
const {title,description,canonical=new URL(Astro.url.pathname,site.url).toString(),jsonLd,noindex=false}=Astro.props;
const localBusiness={'@context':'https://schema.org','@type':'LodgingBusiness',name:site.name,url:site.url,email:site.email,telephone:site.telephoneHref,address:{'@type':'PostalAddress',streetAddress:site.address.street,addressLocality:site.address.locality,addressRegion:site.address.island,postalCode:site.address.postcode,addressCountry:site.address.country},geo:{'@type':'GeoCoordinates',latitude:site.coordinates.latitude,longitude:site.coordinates.longitude}};
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#194c3d"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${site.url}/social-card.svg`}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify(jsonLd?[localBusiness,jsonLd]:[localBusiness])}></script></head><body><a class="skip-link" href="#main-content">Skip to content</a><Header/><main id="main-content"><slot/></main><Footer/></body></html>

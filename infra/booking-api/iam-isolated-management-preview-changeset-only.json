{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManagementPreviewStackOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateStack",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-west-2:145608514666:stack/les-buttes-management-preview-isolated-staging/*"
    },
    {
      "Sid": "ExistingBookingStackReadOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks"
      ],
      "Resource": "arn:aws:cloudformation:eu-west-2:145608514666:stack/les-buttes-booking-staging/*"
    },
    {
      "Sid": "IsolatedPreviewSAMTransform",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-west-2:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "IsolatedManagementPreviewArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::les-buttes-cottage-manag-artifacts-145608514666-eu-west-2/booking-management-preview-isolated/sam/*"
    },
    {
      "Sid": "IsolatedManagementPreviewBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::les-buttes-cottage-manag-artifacts-145608514666-eu-west-2"
    }
  ]
}
